// Mica emitter, written in Mica.
//
// Stage three of the self-hosting path (#81). Consumes relational AST row
// lists `[node, role, target, ordinal]` (see `parse_rows` in parse.mica) and
// produces an `assemble` description map. State is
// `[code, constants, scopes, next_reg, errors, builtins, break_patches,
// continue_patches, continue_marks, loop_depth, max_reg]`, threaded through
// every helper, each returning `[result, state]`, mirroring parse.mica.
// `scopes` is a stack of `[register_mark, locals]` and `locals` holds
// `[name, register]` pairs.
//
// Slice one covers top-level expressions: int, float, and bool literals,
// arithmetic (`+`, `-`, `*`, `/`), `return`, assignment, and `let`/`const`
// bindings.
//
// Slice two adds string and symbol literals (with source-text decoding),
// list and map literals, indexing, unary operators, and the remaining
// binary operators. Anything else records an error naming the unsupported
// node. Calls, control flow, patterns, and identity/error/bytes literals
// arrive in later slices.
//
// Naming follows the parse.mica rules: no local spells a lowercase keyword
// or a keyword identifier, so suffixed names (`left_reg`, `binding_name`)
// throughout.

make_identity(:emitter)

// --- Entry -------------------------------------------------------------------

// Compiles `source` all the way to artifact bytes, returning
// `{:ok -> true, :bytes -> bytes}` or `{:ok -> false, :errors -> [...]}`.
verb emit_source(source) -> map
  let parsed = parse_rows(source)
  if len(parsed[:errors]) > 0
    return {:ok -> false, :errors -> parsed[:errors]}
  end
  let program = emit_program(parsed[:rows], parsed[:root])
  if len(program[:errors]) > 0
    return {:ok -> false, :errors -> program[:errors]}
  end
  return {:ok -> true, :bytes -> assemble(program)}
end

// Lowers fact rows for the program `root` to an assemble description. The
// description carries `:errors` alongside the sections; `assemble` ignores
// unknown keys, so the map feeds it directly.
verb emit_program(raw_rows, root) -> map
  let state = [[], [], [[0, []]], 0, [], [], [], [], [], 0, 0, [], {}, 0, [], [], [], {}, {}, [], [], {}, 0]
  // Sort facts by node id once so every lookup can binary search instead of
  // scanning. Row order is not otherwise observable here.
  let rows = sort_ast_rows(raw_rows)
  let items = ast_children(rows, root, :item)
  if len(items) == 0
    state[4] = [@state[4], "a program needs at least one item"]
    return describe(state, 0)
  end

  // Reserve every verb slot before emitting any body, so a call can name a
  // verb declared later in the file (including forward references and
  // recursion).
  let main_desc = {:name -> "main", :code_offset -> 0, :code_len -> 0,
                   :registers -> 0, :params -> 0, :required -> 0,
                   :rest -> false, :defaults -> []}
  state[11] = [@state[11], main_desc]
  for item in items
    if ast_kind(rows, item) != :VerbItem
      continue
    end
    let [found_name, verb_name] = ast_attr(rows, item, :name)
    if !found_name
      state[4] = [@state[4], "a verb is missing its name"]
      continue
    end
    let params = ast_children(rows, item, :param)
    let has_restriction = params_have_restriction(rows, params)
    let [slot, after_slot] = reserve_verb(rows, params, verb_name, state)
    state = after_slot
    // Slots in declaration order. Body emission walks this list, so each
    // overload gets its own slot rather than all sharing the name's first.
    state[19] = [@state[19], slot]
    // The name table keeps the first slot as a fallback for unknown lookups.
    let table = state[12]
    if index_or(table, verb_name, -1) < 0
      table[verb_name] = slot
    end
    state[12] = table
    // A name with several declarations, or any restricted parameter, must be
    // called through dispatch so every declaration is considered and the
    // restriction is enforced.
    let counts = state[17]
    counts[verb_name] = index_or(counts, verb_name, 0) + 1
    state[17] = counts
    if has_restriction
      let restricted = state[18]
      restricted[verb_name] = true
      state[18] = restricted
    end
  end

  // Emit the entry function: top-level expressions in order, returning the
  // last value.
  state = function_enter(state, 0)
  let last_reg = 0
  let saw_value = false
  for item in items
    if ast_kind(rows, item) != :ExprItem
      continue
    end
    let [found, expr] = ast_attr(rows, item, :expr)
    if !found
      state[4] = [@state[4], "an item is missing its expression"]
      continue
    end
    let [reg, after_expr] = emit_expr(rows, expr, state)
    state = after_expr
    last_reg = reg
    saw_value = true
  end
  if !saw_value
    let [zero_reg, after_zero] = load_constant(state, empty_relation_value())
    state = after_zero
    last_reg = zero_reg
  end
  let [_, after_return] = emit_instruction(state, :Return, 0, last_reg, 0, 0)
  state = after_return
  state = function_leave(state)

  // Emit each verb body. A verb's parameters occupy the first registers of
  // its frame; the body returns its last value. Slots are consumed in the
  // same declaration order the reservation loop recorded, so overloads do not
  // overwrite each other.
  let verb_slots = state[19]
  let verb_slot_index = 0
  for item in items
    if ast_kind(rows, item) != :VerbItem
      continue
    end
    let [found_name, verb_name] = ast_attr(rows, item, :name)
    if !found_name
      continue
    end
    if verb_slot_index >= len(verb_slots)
      continue
    end
    let slot = verb_slots[verb_slot_index]
    verb_slot_index = verb_slot_index + 1
    let params = ast_children(rows, item, :param)
    state = function_enter(state, slot)
    state[3] = len(params)
    state[10] = len(params)
    let param_index = 0
    for param in params
      let [found_param_name, param_name] = ast_attr(rows, param, :name)
      if found_param_name
        state = declare_local(state, param_name, param_index, false)
      end
      param_index = param_index + 1
    end
    let body = ast_children(rows, item, :body)
    let [body_reg, body_has_value, after_body] = emit_block(rows, body, state)
    state = after_body
    let return_reg = body_reg
    if !body_has_value
      let [zero_reg, after_zero] = load_constant(state, empty_relation_value())
      state = after_zero
      return_reg = zero_reg
    end
    let [_, after_return] = emit_instruction(state, :Return, 0, return_reg, 0, 0)
    state = after_return
    state = function_leave(state)
  end

  // Emit queued fn bodies after all outer code is placed.
  state = emit_pending_functions(rows, state)

  return describe(state, last_reg)
end

// The empty-relation constant used for a valueless function result.
verb empty_relation_value()
  return []
end

// Reports whether any parameter declares a restriction (`@ #type`). A
// restricted verb must be called through dispatch so the runtime enforces it.
verb params_have_restriction(rows, params)
  for param in params
    let [found, _] = ast_attr(rows, param, :restrict)
    if found
      return true
    end
  end
  return false
end

// The required-parameter count and rest flag for a parameter list, as
// [required, has_rest]. Required parameters must precede optional and rest
// parameters; a later one is counted as optional.
verb param_arity(rows, params)
  let required = 0
  let has_rest = false
  let seen_optional = false
  for param in params
    let [found_mode, mode] = ast_attr(rows, param, :mode)
    if !found_mode || mode == :req
      if !seen_optional && !has_rest
        required = required + 1
      end
    elseif mode == :rest
      has_rest = true
    else
      seen_optional = true
    end
  end
  return [required, has_rest]
end

// `a..b` builds a range value; `a.._` is open-ended, so the end register
// echoes the start and the flags bit is clear.
verb emit_range(rows, node, state)
  let [found_start, start_node] = ast_attr(rows, node, :start)
  if !found_start
    return emit_error(state, "a range is missing its start")
  end
  let [start, after_start] = emit_expr(rows, start_node, state)
  state = after_start
  let [found_end, end_node] = ast_attr(rows, node, :range_end)
  let end_reg = start
  if found_end
    let [emitted, after_end] = emit_expr(rows, end_node, state)
    state = after_end
    end_reg = emitted
  end
  let flags = 0
  if found_end
    flags = 1
  end
  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_emit] = emit_instruction(state, :Build_Range, flags, dst, start, end_reg)
  state = after_emit
  return [dst, state]
end

// `receiver:selector(args)` dispatches on the receiver plus any named roles.
verb emit_receiver_call(rows, node, state)
  let [found_receiver, receiver_node] = ast_attr(rows, node, :receiver)
  let [found_selector, selector_name] = ast_attr(rows, node, :selector)
  if !found_receiver || !found_selector
    return emit_error(state, "a receiver call is missing its receiver or selector")
  end
  let [receiver, after_receiver] = emit_expr(rows, receiver_node, state)
  state = after_receiver
  let args = ast_children(rows, node, :arg)

  // Named roles mean a Dispatch carrying the receiver as a "receiver" role.
  let any_role = false
  for arg in args
    let [found_role, _] = ast_attr(rows, arg, :role)
    if found_role
      any_role = true
      break
    end
  end
  if any_role
    let roles = []
    roles = [@roles, {:role -> "receiver", :register -> receiver}]
    for arg in args
      let [found_role, role_name] = ast_attr(rows, arg, :role)
      let [found_expr, arg_expr] = ast_attr(rows, arg, :expr)
      if !found_role || !found_expr
        return emit_error(state, "receiver dispatch cannot mix named and positional arguments")
      end
      let [arg_reg, after_arg] = emit_expr(rows, arg_expr, state)
      state = after_arg
      roles = [@roles, {:role -> role_name, :register -> arg_reg}]
    end
    let spec_index = len(state[15])
    state[15] = [@state[15], {:selector -> selector_name, :roles -> roles}]
    let [dst, after_dst] = alloc_register(state)
    state = after_dst
    let [_, after_dispatch] = emit_instruction(state, :Dispatch, 0, dst, spec_index, 0)
    state = after_dispatch
    return [dst, state]
  end

  // Positional: the receiver is the first argument.
  let registers = [receiver]
  for arg in args
    let [found_expr, arg_expr] = ast_attr(rows, arg, :expr)
    if !found_expr
      return emit_error(state, "a receiver call argument is missing its expression")
    end
    let [arg_reg, after_arg] = emit_expr(rows, arg_expr, state)
    state = after_arg
    registers = [@registers, arg_reg]
  end
  let [first, after_marshal] = marshal_arguments(state, registers)
  state = after_marshal
  let [selector, after_selector] = load_constant(state, to_symbol(selector_name))
  state = after_selector
  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_dispatch] = emit_instruction(
    state, :Positional_Dispatch, len(registers), dst, selector, first,
  )
  state = after_dispatch
  return [dst, state]
end

// `[:a, :b] {[1, 2]}` builds a relation value through __relation_literal,
// which takes a heading list and a rows list.
verb emit_relation_literal(rows, node, state)
  let heading_nodes = ast_children(rows, node, :heading)
  let [heading, after_heading] = emit_list_of_nodes(rows, heading_nodes, state)
  state = after_heading
  let row_nodes = ast_children(rows, node, :row)
  let [rows_reg, after_rows] = emit_list_of_nodes(rows, row_nodes, state)
  state = after_rows
  let [first, after_marshal] = marshal_arguments(state, [heading, rows_reg])
  state = after_marshal
  let [builtin, after_builtin] = add_builtin(state, "__relation_literal")
  state = after_builtin
  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_call] = emit_instruction(state, :Builtin_Call, 2, dst, builtin, first)
  state = after_call
  return [dst, state]
end

// `b"..."` is a base64url-encoded byte string. Decoding happens at execution
// time via __bytes, since the Mica emitter has no base64 facility of its own.
verb emit_bytes_literal(rows, node, state)
  let [found, text] = ast_attr(rows, node, :text)
  if !found
    return emit_error(state, "a byte literal is missing its text")
  end
  let [text_reg, after_text] = load_constant(state, text)
  state = after_text
  let [first, after_marshal] = marshal_arguments(state, [text_reg])
  state = after_marshal
  let [builtin, after_builtin] = add_builtin(state, "__bytes")
  state = after_builtin
  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_call] = emit_instruction(state, :Builtin_Call, 1, dst, builtin, first)
  state = after_call
  return [dst, state]
end

// A named recursive `fn f(...)`: emits Make_Self_Function, which supplies the
// function's own value as its last capture so the body can call itself.
verb emit_self_fn(rows, node, self_name, state)
  let index = len(state[11])
  let params = ast_children(rows, node, :param)
  let [required, has_rest] = param_arity(rows, params)
  let desc = {:name -> "fn", :code_offset -> 0, :code_len -> 0,
              :registers -> 0, :params -> len(params), :required -> required,
              :rest -> has_rest, :defaults -> []}
  state[11] = [@state[11], desc]

  // Captures are the visible locals plus a trailing slot for the function's
  // own value, which the VM fills in.
  let captures = all_locals(state)
  let [scratch, after_scratch] = alloc_register(state)
  state = after_scratch
  captures = [@captures, [self_name, scratch]]
  if len(captures) > 255
    return emit_error(state, "a closure may capture at most 255 values")
  end
  let capture_registers = []
  for capture in captures
    capture_registers = [@capture_registers, capture[1]]
  end
  let [first_capture, after_marshal] = marshal_arguments(state, capture_registers)
  state = after_marshal

  state[20] = [@state[20], {:index -> index, :node -> node, :captures -> captures}]

  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_emit] = emit_instruction(
    state, :Make_Self_Function, len(captures), dst, index, first_capture,
  )
  state = after_emit
  return [dst, state]
end

// Every visible local, innermost scope first, as [name, register] pairs. Used
// to capture a closure's environment by value.
verb all_locals(state)
  let locals = []
  let scopes = state[2]
  let depth = len(scopes) - 1
  while depth >= 0
    let scope_locals = scopes[depth][1]
    for entry in scope_locals
      locals = [@locals, entry]
    end
    depth = depth - 1
  end
  return locals
end

// `fn(params) => body` and `fn(params) ... end` make a function value that
// captures every visible local by value. The body is emitted later, after the
// enclosing code, so a slot is reserved now and the body queued.
verb emit_fn_literal(rows, node, state)
  let index = len(state[11])
  let params = ast_children(rows, node, :param)
  let [required, has_rest] = param_arity(rows, params)
  let desc = {:name -> "fn", :code_offset -> 0, :code_len -> 0,
              :registers -> 0, :params -> len(params), :required -> required,
              :rest -> has_rest, :defaults -> []}
  state[11] = [@state[11], desc]

  // Capture every visible local. Captures land in the callee's first
  // registers, before its parameters.
  let captures = all_locals(state)
  if len(captures) > 255
    return emit_error(state, "a closure may capture at most 255 values")
  end
  let capture_registers = []
  for capture in captures
    capture_registers = [@capture_registers, capture[1]]
  end
  let [first_capture, after_marshal] = marshal_arguments(state, capture_registers)
  state = after_marshal

  // Queue the body; deferring keeps the enclosing code contiguous.
  state[20] = [@state[20], {:index -> index, :node -> node, :captures -> captures}]

  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_emit] = emit_instruction(
    state, :Make_Function, len(captures), dst, index, first_capture,
  )
  state = after_emit
  return [dst, state]
end

// Emits every queued fn body. A body captures its environment in the first
// registers (declared as locals), then binds its parameters after them.
verb emit_pending_functions(rows, state)
  let pending_index = 0
  while pending_index < len(state[20])
    // A body may itself contain fn literals, which append to the queue as it
    // runs; re-read the list each iteration so those are included.
    let entry = state[20][pending_index]
    pending_index = pending_index + 1
    state = function_enter(state, entry[:index])
    let captures = entry[:captures]
    let capture_count = len(captures)
    let params = ast_children(rows, entry[:node], :param)
    state[3] = capture_count + len(params)
    state[10] = state[3]
    let capture_index = 0
    for capture in captures
      state = declare_local(state, capture[0], capture_index, false)
      capture_index = capture_index + 1
    end
    let param_index = 0
    for param in params
      let [found_param_name, param_name] = ast_attr(rows, param, :name)
      if found_param_name
        state = declare_local(state, param_name, capture_count + param_index, false)
      end
      param_index = param_index + 1
    end

    let [found_expr_body, _] = ast_attr(rows, entry[:node], :has_expression_body)
    let return_reg = 0
    let has_return = false
    if found_expr_body
      let [found_body, body_node] = ast_attr(rows, entry[:node], :expression_body)
      if found_body
        let [reg, after_body] = emit_expr(rows, body_node, state)
        state = after_body
        return_reg = reg
        has_return = true
      end
    else
      let body = ast_children(rows, entry[:node], :body)
      let [reg, body_has_value, after_body] = emit_block(rows, body, state)
      state = after_body
      return_reg = reg
      has_return = body_has_value
    end
    if !has_return
      let [zero_reg, after_zero] = load_constant(state, empty_relation_value())
      state = after_zero
      return_reg = zero_reg
    end
    let [_, after_return] = emit_instruction(state, :Return, 0, return_reg, 0, 0)
    state = after_return
    state = function_leave(state)
  end
  return state
end

// Reserves a function slot for a verb's parameters, returning [index, state].
// Parameter metadata (required count, rest flag) is recorded now; the body is
// emitted later. The name is recorded so dispatch can resolve the method.
verb reserve_verb(rows, params, function_name, state)
  let index = len(state[11])
  let [required, has_rest] = param_arity(rows, params)
  let desc = {:name -> function_name, :code_offset -> 0, :code_len -> 0,
              :registers -> 0, :params -> len(params), :required -> required,
              :rest -> has_rest, :defaults -> []}
  state[11] = [@state[11], desc]
  return [index, state]
end

// Looks up a reserved function by name as [found, index].
verb find_function(state, function_name)
  let table = state[12]
  if index_or(table, function_name, -1) >= 0
    return [true, table[function_name]]
  end
  return [false, -1]
end

// Begins emitting a function: selects the slot, records its code offset, and
// resets the register and scope bookkeeping.
verb function_enter(state, index)
  state[13] = index
  let functions = state[11]
  let desc = functions[index]
  desc[:code_offset] = current_offset(state)
  functions[index] = desc
  state[11] = functions
  state[3] = 0
  state[10] = 0
  state[2] = [[0, []]]
  state[9] = 0
  state[6] = []
  state[7] = []
  state[8] = []
  // The constant cache and the register floor that guards it are per function.
  state[21] = {}
  state[22] = 0
  return state
end

// Finishes a function: records its code length and register count.
verb function_leave(state)
  let functions = state[11]
  let index = state[13]
  let desc = functions[index]
  desc[:code_len] = current_offset(state) - desc[:code_offset]
  desc[:registers] = state[10]
  functions[index] = desc
  state[11] = functions
  return state
end

// Builds the assemble description map from finished emitter state.
verb describe(state, last_reg)
  let code = state[0]
  let constants = state[1]
  let errors = state[4]
  let builtins = state[5]
  return {:entry -> 0, :code -> code, :constants -> constants,
          :functions -> state[11], :patterns -> state[14], :shapes -> [],
          :specs -> state[15], :builtins -> builtins, :errors -> errors}
end

// --- Fact queries ------------------------------------------------------------

// Sorts AST rows by node id, then role, target, and ordinal. Node ids are
// dense but a node's rows are not contiguous in emission order (a parent's
// facts follow its children's), so a one-time sort lets every lookup binary
// search a node's block instead of scanning all rows. Without this, emission
// is quadratic in node count, which a 70 KB source cannot survive.
verb sort_ast_rows(rows)
  return sort(rows)
end

// The first row index whose node id is `node_id`, or the insertion point when
// absent. Rows must be sorted by node id. Mica integer division is exact, so
// the midpoint forces an even numerator rather than writing `(low + high) / 2`.
verb lower_bound(rows, node_id)
  let low = 0
  let high = len(rows)
  while low < high
    let sum = low + high
    let mid = (sum - (sum % 2)) / 2
    if rows[mid][0] < node_id
      low = mid + 1
    else
      high = mid
    end
  end
  return low
end

// The :kind target of a node, or :Unknown.
verb ast_kind(rows, node_id)
  let index = lower_bound(rows, node_id)
  while index < len(rows) && rows[index][0] == node_id
    if rows[index][1] == :kind
      return rows[index][2]
    end
    index = index + 1
  end
  return :Unknown
end

// The first target for (node, role) as [found, target].
verb ast_attr(rows, node_id, role)
  let index = lower_bound(rows, node_id)
  while index < len(rows) && rows[index][0] == node_id
    if rows[index][1] == role
      return [true, rows[index][2]]
    end
    index = index + 1
  end
  return [false, 0]
end

// Every target for (node, role), ordered by ordinal. The node's block is
// small, so scanning it once per ordinal is cheap.
verb ast_children(rows, node_id, role)
  let start = lower_bound(rows, node_id)
  let finish = start
  while finish < len(rows) && rows[finish][0] == node_id
    finish = finish + 1
  end
  let count = 0
  let index = start
  while index < finish
    if rows[index][1] == role
      count = count + 1
    end
    index = index + 1
  end
  let targets = []
  let ordinal = 0
  while ordinal < count
    index = start
    while index < finish
      if rows[index][1] == role && rows[index][3] == ordinal
        targets = [@targets, rows[index][2]]
        break
      end
      index = index + 1
    end
    ordinal = ordinal + 1
  end
  return targets
end

// The current instruction count: the next instruction's offset.
verb current_offset(state)
  return len(state[0])
end

// Drops the constant cache and its register floor `state[22]`. Called at every
// block boundary: a load emitted on one path is not known to have run on
// another, so nothing cached before the boundary may be reused after it. Once
// the cache is empty its floor no longer guards any register, so it resets too
// and scope exit can reclaim registers again.
verb forget_constants(state)
  state[21] = {}
  state[22] = 0
  return state
end

// Appends a jump whose target is filled in later, returning [offset, state].
verb emit_jump(state, op_sym, flags, a)
  let [offset, after_emit] = emit_instruction(state, op_sym, flags, a, 0, 0)
  state = forget_constants(after_emit)
  return [offset, state]
end

// Sets the target of a placeholder jump. Offsets are relative to the
// instruction after the jump, matching the VM's `ip += b`.
verb patch_jump(state, at, target)
  let code = state[0]
  let instruction = code[at]
  instruction[:b] = target - (at + 1)
  code[at] = instruction
  state[0] = code
  state = forget_constants(state)
  return state
end

// --- Scope helpers -----------------------------------------------------------

// Begins a scope: later register allocations and local declarations are
// discarded when the matching scope_leave runs. A scope is
// `[register_mark, locals]`, where `locals` holds `[name, register]` pairs.
verb scope_enter(state)
  let scopes = state[2]
  scopes = [@scopes, [state[3], []]]
  state[2] = scopes
  return state
end

verb scope_leave(state)
  let scopes = state[2]
  if len(scopes) == 0
    return state
  end
  let mark = scopes[len(scopes) - 1][0]
  // Reclaiming to `mark` frees every register at or above it, and a later
  // allocation could then clobber a cached constant sitting there. Drop the
  // cache in that case instead of pinning registers, which would inflate the
  // frame. When `mark` clears every cached register the cache survives.
  if mark < state[22]
    state = forget_constants(state)
  end
  state[3] = mark
  state[2] = __list_slice(scopes, 0, len(scopes) - 1)
  return state
end

// --- State helpers -----------------------------------------------------------

// Appends an instruction map, returning [offset, state].
verb emit_instruction(state, op_sym, flags, a, b, c)
  let offset = len(state[0])
  state[0] = [@state[0], {:op -> op_sym, :flags -> flags, :a -> a, :b -> b, :c -> c}]
  return [offset, state]
end

// Appends a constant value, returning [index, state]. No deduplication;
// indices stay fresh by construction.
verb emit_constant(state, const_value)
  let index = len(state[1])
  state[1] = [@state[1], const_value]
  return [index, state]
end

// Reserves the next register, returning [register, state]. Registers never
// reuse in this slice; scope exit does not reclaim.
verb alloc_register(state)
  let reg = state[3]
  state[3] = reg + 1
  if state[3] > state[10]
    state[10] = state[3]
  end
  return [reg, state]
end

// Registers a builtin name, returning [index, state]. Names are not
// deduplicated, matching the Odin emitter: an unused duplicate is harmless
// and dedup would need a lookup table here.
verb add_builtin(state, builtin_name)
  let index = len(state[5])
  state[5] = [@state[5], builtin_name]
  return [index, state]
end

// Reserves `len(registers)` consecutive registers and moves each value into
// its slot, returning [first, state]. The VM reads call and build operands
// from consecutive registers.
verb marshal_arguments(state, registers)
  if len(registers) == 0
    return [0, state]
  end
  let [first, after_first] = alloc_register(state)
  state = after_first
  let reserved = 1
  while reserved < len(registers)
    let [_, after_more] = alloc_register(state)
    state = after_more
    reserved = reserved + 1
  end
  let index = 0
  for register in registers
    if register != first + index
      let [_, after_move] = emit_instruction(state, :Move, 0, first + index, register, 0)
      state = after_move
    end
    index = index + 1
  end
  return [first, state]
end

// Records an emitter error, returning [0, state] as a dummy register.
verb emit_error(state, message)
  state[4] = [@state[4], message]
  return [0, state]
end

// Declares `binding_name` at `reg` in the innermost scope. A const binding
// cannot be reassigned.
verb declare_local(state, binding_name, reg, constant_flag)
  let scopes = state[2]
  let top = scopes[len(scopes) - 1]
  let locals = top[1]
  locals = [@locals, [binding_name, reg, constant_flag]]
  top[1] = locals
  scopes[len(scopes) - 1] = top
  state[2] = scopes
  return state
end

// Resolves a name from the innermost scope outward as
// [found, register, is_const].
verb resolve_local(state, binding_name)
  let scopes = state[2]
  let depth = len(scopes) - 1
  while depth >= 0
    let locals = scopes[depth][1]
    let index = len(locals) - 1
    while index >= 0
      if locals[index][0] == binding_name
        return [true, locals[index][1], locals[index][2]]
      end
      index = index - 1
    end
    depth = depth - 1
  end
  return [false, 0, false]
end

// --- Expressions -------------------------------------------------------------

// Emits an expression, returning [result register, state].
verb emit_expr(rows, node, state)
  let kind = ast_kind(rows, node)
  if kind == :Int_Literal
    return emit_int_literal(rows, node, state)
  end
  if kind == :Float_Literal
    return emit_float_literal(rows, node, state)
  end
  if kind == :Bool_Literal
    return emit_bool_literal(rows, node, state)
  end
  if kind == :String_Literal
    return emit_string_literal(rows, node, state)
  end
  if kind == :Symbol_Literal
    return emit_symbol_literal(rows, node, state)
  end
  if kind == :Error_Code_Literal
    return emit_error_code_literal(rows, node, state)
  end
  if kind == :Identity_Literal
    return emit_identity_literal(rows, node, state)
  end
  if kind == :Name
    return emit_name(rows, node, state)
  end
  if kind == :Unary
    return emit_unary(rows, node, state)
  end
  if kind == :Binary
    return emit_binary(rows, node, state)
  end
  if kind == :List_Literal
    return emit_list_literal(rows, node, state)
  end
  if kind == :Comprehension
    return emit_comprehension(rows, node, state)
  end
  if kind == :Map_Literal
    return emit_map_literal(rows, node, state)
  end
  if kind == :Index
    return emit_index(rows, node, state)
  end
  if kind == :Call
    return emit_call(rows, node, state)
  end
  if kind == :Field
    return emit_field(rows, node, state)
  end
  if kind == :If
    return emit_if(rows, node, state)
  end
  if kind == :While
    return emit_while(rows, node, state)
  end
  if kind == :For
    return emit_for(rows, node, state)
  end
  if kind == :Begin
    return emit_begin(rows, node, state)
  end
  if kind == :Break
    return emit_break(state)
  end
  if kind == :Continue
    return emit_continue(state)
  end
  if kind == :Require
    return emit_require(rows, node, state)
  end
  if kind == :Assert
    return emit_relation_write(rows, node, true, state)
  end
  if kind == :Retract
    return emit_relation_write(rows, node, false, state)
  end
  if kind == :Spawn
    return emit_spawn(rows, node, state)
  end
  if kind == :Try
    return emit_try(rows, node, state)
  end
  if kind == :Fn
    return emit_fn_literal(rows, node, state)
  end
  if kind == :Bytes_Literal
    return emit_bytes_literal(rows, node, state)
  end
  if kind == :Range_Literal
    return emit_range(rows, node, state)
  end
  if kind == :Receiver_Call
    return emit_receiver_call(rows, node, state)
  end
  if kind == :Relation_Literal
    return emit_relation_literal(rows, node, state)
  end
  if kind == :Dom_Element
    return emit_dom_element(rows, node, state)
  end
  if kind == :Dom_Text
    return emit_dom_text(rows, node, state)
  end
  if kind == :Match
    return emit_match(rows, node, state)
  end
  if kind == :Raise
    return emit_raise(rows, node, state)
  end
  if kind == :Structural_Literal
    return emit_frob(rows, node, state)
  end
  if kind == :Binding
    return emit_binding(rows, node, state)
  end
  if kind == :Assignment
    return emit_assignment(rows, node, state)
  end
  if kind == :Return
    return emit_return(rows, node, state)
  end
  return emit_error(state, string_concat("unsupported expression: ", to_literal(ast_kind(rows, node))))
end

verb emit_int_literal(rows, node, state)
  let [found, text] = ast_attr(rows, node, :text)
  if !found
    return emit_error(state, "an int literal is missing its text")
  end
  let [index, after_const] = emit_constant(state, parse_int(text))
  state = after_const
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Load_Const, 0, dst, index, 0)
  state = after_emit
  return [dst, state]
end

verb emit_float_literal(rows, node, state)
  let [found, text] = ast_attr(rows, node, :text)
  if !found
    return emit_error(state, "a float literal is missing its text")
  end
  let [index, after_const] = emit_constant(state, parse_float(text))
  state = after_const
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Load_Const, 0, dst, index, 0)
  state = after_emit
  return [dst, state]
end

verb emit_bool_literal(rows, node, state)
  let [found, flag] = ast_attr(rows, node, :value)
  if !found
    return emit_error(state, "a bool literal is missing its value")
  end
  let [index, after_const] = emit_constant(state, flag)
  state = after_const
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Load_Const, 0, dst, index, 0)
  state = after_emit
  return [dst, state]
end

// Loads `const_value` into a register, reusing one if the same value was
// already loaded in the current basic block. A literal otherwise reloads at
// every occurrence; on the compiler's own sources the cache removes 10-19% of
// Load_Const instructions, dominated by the instruction-field literals 0 and
// 1.
//
// The cache is only valid within a straight-line block; every branch, jump,
// and merge point clears it, because a load emitted on one path is not known
// to have run on another. `state[22]` records the highest register handed out
// so far; scope_leave drops the cache when its reclaim mark would free one of
// those registers, so no cached register is ever clobbered.
verb load_constant(state, const_value)
  let cache = state[21]
  let cached = index_or(cache, const_value, -1)
  if cached >= 0
    return [cached, state]
  end
  let [index, after_const] = emit_constant(state, const_value)
  state = after_const
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Load_Const, 0, dst, index, 0)
  state = after_emit
  cache = state[21]
  cache[const_value] = dst
  state[21] = cache
  if state[3] > state[22]
    state[22] = state[3]
  end
  return [dst, state]
end

// A string literal's text is stored raw (with quotes and escapes) because
// the lexer records token text verbatim. Decode it here, then intern.
verb emit_string_literal(rows, node, state)
  let [found, text] = ast_attr(rows, node, :text)
  if !found
    return emit_error(state, "a string literal is missing its text")
  end
  return load_constant(state, decode_string_literal(text))
end

// The :name of a symbol or identity literal, with quotes decoded when the
// source wrote `:"..."`.
verb literal_name(rows, node)
  let [found, text] = ast_attr(rows, node, :name)
  if !found
    return [false, ""]
  end
  if len(text) > 0 && text[0] == 34
    return [true, decode_string_literal(text)]
  end
  return [true, text]
end

verb emit_symbol_literal(rows, node, state)
  let [found, text] = literal_name(rows, node)
  if !found
    return emit_error(state, "a symbol literal is missing its name")
  end
  return load_constant(state, to_symbol(text))
end

verb emit_error_code_literal(rows, node, state)
  let [found, text] = ast_attr(rows, node, :text)
  if !found
    return emit_error(state, "an error-code literal is missing its text")
  end
  return load_constant(state, from_literal(text)[:value])
end

// `#123` is a raw identity. `#name` must have been created by the world and
// declared through `make_identity` before this emitter runs.
// `#123` is a raw identity; `#name` resolves at execution time against the
// running world. The Mica emitter runs in a compiler world that does not know
// the target's identities, so it cannot resolve a name here.
verb emit_identity_literal(rows, node, state)
  let [found, text] = literal_name(rows, node)
  if !found
    return emit_error(state, "an identity literal is missing its name")
  end
  let [name_reg, after_name] = load_constant(state, to_symbol(text))
  state = after_name
  let [first, after_marshal] = marshal_arguments(state, [name_reg])
  state = after_marshal
  let [builtin, after_builtin] = add_builtin(state, "__identity")
  state = after_builtin
  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_call] = emit_instruction(state, :Builtin_Call, 1, dst, builtin, first)
  state = after_call
  return [dst, state]
end

// Decodes a source literal, stripping the surrounding quotes and expanding
// the backslash escapes the lexer allowed. A value without a leading quote
// is returned unchanged.
verb decode_string_literal(text)
  if string_len(text) < 2 || text[0] != 34
    return text
  end
  let body = string_slice(text, 1, string_len(text) - 1)
  if !string_contains(body, "\\")
    return body
  end
  let out = ""
  let index = 0
  let length = string_len(body)
  while index < length
    let current = string_slice(body, index, index + 1)
    if current != "\\" || index + 1 >= length
      out = string_append(out, current)
      index = index + 1
      continue
    end
    index = index + 1
    let escaped = string_slice(body, index, index + 1)
    if escaped == "n"
      out = string_append(out, "\n")
    elseif escaped == "t"
      out = string_append(out, "\t")
    elseif escaped == "r"
      out = string_append(out, "\r")
    elseif escaped == "0"
      out = string_append(out, "\0")
    elseif escaped == "\\"
      out = string_append(out, "\\")
    elseif escaped == "\""
      out = string_append(out, "\"")
    else
      out = string_append(out, "\\")
      out = string_append(out, escaped)
    end
    index = index + 1
  end
  return out
end

// A bare name evaluates to its register; no copy.
verb emit_name(rows, node, state)
  let [named, binding_name] = single_name(rows, node)
  if !named
    return emit_error(state, "a qualified name needs a later slice")
  end
  // `none` is an option literal, not a binding: the empty relation headed
  // `[:value]`.
  if binding_name == "none"
    return load_constant(state, none_value())
  end
  let [found, reg] = resolve_local(state, binding_name)
  if !found
    return emit_error(state, string_concat("unknown name: ", binding_name))
  end
  return [reg, state]
end

// The `none` value: a relation with heading [:value] and no rows.
verb none_value()
  return __relation_literal([:value], [])
end

// The single-part name text of a :Name node as [ok, text].
verb single_name(rows, node)
  let parts = ast_children(rows, node, :part)
  if len(parts) != 1
    return [false, ""]
  end
  return [true, parts[0]]
end

// Joins a name node's parts with '/', matching the Odin emitter. A single
// part is returned unchanged. Returns [ok, text]; ok is false for no parts.
verb join_name(rows, node)
  let parts = ast_children(rows, node, :part)
  if len(parts) == 0
    return [false, ""]
  end
  if len(parts) == 1
    return [true, parts[0]]
  end
  let text = parts[0]
  let index = 1
  while index < len(parts)
    text = string_concat(text, "/", parts[index])
    index = index + 1
  end
  return [true, text]
end

verb emit_binary(rows, node, state)
  let [found_op, op_sym] = ast_attr(rows, node, :op)
  if found_op && (op_sym == :and || op_sym == :or)
    return emit_short_circuit(rows, node, op_sym == :and, state)
  end
  let flag = binary_flag(op_sym)
  if !found_op || flag < 0
    return emit_error(state, "an operator needs a later slice")
  end
  let [found_left, left_node] = ast_attr(rows, node, :left)
  let [found_right, right_node] = ast_attr(rows, node, :right)
  if !found_left || !found_right
    return emit_error(state, "a binary operator is missing an operand")
  end
  let [left_reg, after_left] = emit_expr(rows, left_node, state)
  state = after_left
  let [right_reg, after_right] = emit_expr(rows, right_node, state)
  state = after_right
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Binary, flag, dst, left_reg, right_reg)
  state = after_emit
  return [dst, state]
end

// `a && b` and `a || b` short-circuit: the right operand is only evaluated
// when the left does not decide the result.
verb emit_short_circuit(rows, node, is_and, state)
  let [found_left, left_node] = ast_attr(rows, node, :left)
  let [found_right, right_node] = ast_attr(rows, node, :right)
  if !found_left || !found_right
    return emit_error(state, "a logical operator is missing an operand")
  end
  let [left, after_left] = emit_expr(rows, left_node, state)
  state = after_left
  let [result, after_result] = alloc_register(state)
  state = after_result
  let [truth, after_truth] = alloc_register(state)
  state = after_truth
  let [_, after_truthy] = emit_instruction(state, :Is_Truthy, 0, truth, left, 0)
  state = after_truthy
  let [branch, after_branch] = emit_jump(state, :Branch, 0, truth)
  state = after_branch

  if is_and
    // Falsy left decides false.
    let [false_reg, after_false] = load_constant(state, false)
    state = after_false
    let [_, after_move] = emit_instruction(state, :Move, 0, result, false_reg, 0)
    state = after_move
    let [end_jump, after_end_jump] = emit_jump(state, :Jump, 0, 0)
    state = after_end_jump
    state = patch_jump(state, branch, current_offset(state))
    let [right, after_right] = emit_expr(rows, right_node, state)
    state = after_right
    let [_, after_right_move] = emit_instruction(state, :Move, 0, result, right, 0)
    state = after_right_move
    state = patch_jump(state, end_jump, current_offset(state))
    return [result, state]
  end

  // Truthy left decides true; otherwise the right operand.
  let [right, after_right] = emit_expr(rows, right_node, state)
  state = after_right
  let [_, after_right_move] = emit_instruction(state, :Move, 0, result, right, 0)
  state = after_right_move
  let [end_jump, after_end_jump] = emit_jump(state, :Jump, 0, 0)
  state = after_end_jump
  state = patch_jump(state, branch, current_offset(state))
  let [true_reg, after_true] = load_constant(state, true)
  state = after_true
  let [_, after_true_move] = emit_instruction(state, :Move, 0, result, true_reg, 0)
  state = after_true_move
  state = patch_jump(state, end_jump, current_offset(state))
  return [result, state]
end

// The Bin_Op flag for a parser operator symbol, or -1 when unsupported.
// The order matches vm.Bin_Op: Add, Sub, Mul, Div, Rem, Eq, Ne, Lt, Le, Gt,
// Ge. Short-circuit `and`/`or` need control flow and arrive later.
verb binary_flag(op_sym)
  if op_sym == :add
    return 0
  end
  if op_sym == :sub
    return 1
  end
  if op_sym == :mul
    return 2
  end
  if op_sym == :div
    return 3
  end
  if op_sym == :rem
    return 4
  end
  if op_sym == :eq
    return 5
  end
  if op_sym == :ne
    return 6
  end
  if op_sym == :lt
    return 7
  end
  if op_sym == :le
    return 8
  end
  if op_sym == :gt
    return 9
  end
  if op_sym == :ge
    return 10
  end
  return -1
end

verb emit_unary(rows, node, state)
  let [found_op, op_sym] = ast_attr(rows, node, :op)
  let [found_operand, operand_node] = ast_attr(rows, node, :operand)
  if !found_op || !found_operand
    return emit_error(state, "a unary operator is missing its operand")
  end
  let flag = 0
  if op_sym == :not_op
    flag = 1
  end
  let [operand_reg, after_operand] = emit_expr(rows, operand_node, state)
  state = after_operand
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Unary, flag, dst, operand_reg, 0)
  state = after_emit
  return [dst, state]
end

verb emit_list_literal(rows, node, state)
  let elements = ast_children(rows, node, :element)
  let has_splice = list_has_splice(rows, elements)
  let splice_count = list_splice_count(rows, elements)

  // The append idiom `[@items, x]` (one splice, one value, splice first)
  // lowers to __list_append rather than a concat. Concat rebuilds and copies
  // the whole prefix, making a build-loop quadratic; append reuses capacity.
  if splice_count == 1 && len(elements) == 2 && ast_kind(rows, elements[0]) == :Splice
    let splice = elements[0]
    let [found_spliced, spliced_node] = ast_attr(rows, splice, :value)
    if found_spliced && ast_kind(rows, elements[1]) != :Splice
      let [base, after_base] = emit_expr(rows, spliced_node, state)
      state = after_base
      let [item, after_item] = emit_expr(rows, elements[1], state)
      state = after_item
      let [first, after_marshal] = marshal_arguments(state, [base, item])
      state = after_marshal
      let [builtin, after_builtin] = add_builtin(state, "__list_append")
      state = after_builtin
      let [dst, after_reg] = alloc_register(state)
      state = after_reg
      let [_, after_emit] = emit_instruction(state, :Builtin_Call, 0, dst, builtin, first)
      state = after_emit
      return [dst, state]
    end
  end

  let registers = []
  for element in elements
    if ast_kind(rows, element) == :Splice
      let [found_spliced, spliced_node] = ast_attr(rows, element, :value)
      if !found_spliced
        return emit_error(state, "a splice is missing its value")
      end
      let [reg, after_expr] = emit_expr(rows, spliced_node, state)
      state = after_expr
      registers = [@registers, reg]
      continue
    end
    let [reg, after_expr] = emit_expr(rows, element, state)
    state = after_expr
    if has_splice
      let [wrapped, after_wrap] = emit_singleton_list(state, reg)
      state = after_wrap
      registers = [@registers, wrapped]
    else
      registers = [@registers, reg]
    end
  end

  if has_splice
    let [first, after_marshal] = marshal_arguments(state, registers)
    state = after_marshal
    let [builtin, after_builtin] = add_builtin(state, "__list_concat")
    state = after_builtin
    let [dst, after_reg] = alloc_register(state)
    state = after_reg
    let [_, after_emit] = emit_instruction(
      state, :Builtin_Call, len(registers), dst, builtin, first,
    )
    state = after_emit
    return [dst, state]
  end

  let [first, after_marshal] = marshal_arguments(state, registers)
  state = after_marshal
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Build_List, 0, dst, first, len(registers))
  state = after_emit
  return [dst, state]
end

verb list_has_splice(rows, elements)
  for element in elements
    if ast_kind(rows, element) == :Splice
      return true
    end
  end
  return false
end

verb list_splice_count(rows, elements)
  let count = 0
  for element in elements
    if ast_kind(rows, element) == :Splice
      count = count + 1
    end
  end
  return count
end

// Builds a one-element list holding `reg`, returning [register, state]. Used
// to mix a plain value into a concat that also has splices.
verb emit_singleton_list(state, reg)
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Build_List, 0, dst, reg, 1)
  state = after_emit
  return [dst, state]
end

// A comprehension `[body for pattern in iterable if cond sort key]` builds a
// list by iterating the source, optionally filtering, appending `body` (or a
// [key, body] pair when a sort key is given), then optionally sorting.
verb emit_comprehension(rows, node, state)
  let [found_iterable, iterable_node] = ast_attr(rows, node, :iterable)
  let [found_body, body_node] = ast_attr(rows, node, :body)
  let [found_pattern, pattern_node] = ast_attr(rows, node, :pattern)
  if !found_iterable || !found_body || !found_pattern
    return emit_error(state, "a comprehension is missing a clause")
  end
  let [iterable, after_iterable] = emit_expr(rows, iterable_node, state)
  state = after_iterable

  let [accumulator, after_accumulator] = alloc_register(state)
  state = after_accumulator
  let [_, after_build] = emit_instruction(state, :Build_List, 0, accumulator, 0, 0)
  state = after_build

  state[9] = state[9] + 1
  let loop_depth = state[9]
  let break_mark = len(state[6])

  state = scope_enter(state)
  let [index_reg, after_index] = alloc_register(state)
  state = after_index
  let [zero_reg, after_zero_const] = load_constant(state, 0)
  state = after_zero_const
  let [_, after_zero] = emit_instruction(state, :Move, 0, index_reg, zero_reg, 0)
  state = after_zero
  let [length_reg, after_length] = alloc_register(state)
  state = after_length
  let [_, after_len] = emit_instruction(state, :Len, 0, length_reg, iterable, 0)
  state = after_len

  let loop_start = current_offset(state)
  state[8] = [@state[8], len(state[7])]
  let [condition_reg, after_condition] = alloc_register(state)
  state = after_condition
  let [_, after_lt] = emit_instruction(state, :Binary, 7, condition_reg, index_reg, length_reg)
  state = after_lt
  let [body_jump, after_body_jump] = emit_jump(state, :Branch, 0, condition_reg)
  state = after_body_jump
  let [exit_jump, after_exit_jump] = emit_jump(state, :Jump, 0, 0)
  state = after_exit_jump
  state = patch_jump(state, body_jump, current_offset(state))

  let [item_reg, after_item] = alloc_register(state)
  state = after_item
  let [_, after_item_at] = emit_instruction(state, :Collection_Value_At, 0, item_reg, iterable, index_reg)
  state = after_item_at
  state = scope_enter(state)
  state = bind_for_pattern(rows, pattern_node, item_reg, state)

  let [found_condition, condition_node] = ast_attr(rows, node, :condition)
  if found_condition
    let [keep, after_keep] = emit_expr(rows, condition_node, state)
    state = after_keep
    let [enter_jump, after_enter_jump] = emit_jump(state, :Branch, 0, keep)
    state = after_enter_jump
    let [skip_jump, after_skip_jump] = emit_jump(state, :Jump, 0, 0)
    state = after_skip_jump
    state = patch_jump(state, enter_jump, current_offset(state))
    state = emit_comprehension_append(rows, node, body_node, accumulator, state)
    state = patch_jump(state, skip_jump, current_offset(state))
  else
    state = emit_comprehension_append(rows, node, body_node, accumulator, state)
  end
  state = scope_leave(state)

  let increment_start = current_offset(state)
  state = patch_loop_continues(state, increment_start)
  let [one_reg, after_one] = load_constant(state, 1)
  state = after_one
  let [_, after_inc] = emit_instruction(state, :Binary, 0, index_reg, index_reg, one_reg)
  state = after_inc
  let [back_jump, after_back] = emit_jump(state, :Jump, 0, 0)
  state = after_back
  state = patch_jump(state, back_jump, loop_start)
  state = patch_jump(state, exit_jump, current_offset(state))
  state = patch_loop_breaks(state, break_mark)
  state = scope_leave(state)
  state[9] = loop_depth - 1

  // Without a sort clause the accumulator is the result.
  let [found_sort, _] = ast_attr(rows, node, :sort_bare)
  let [found_key, key_node] = ast_attr(rows, node, :key)
  if !found_sort && !found_key
    return [accumulator, state]
  end

  // `sort` sorts the accumulator, which holds [key, body] pairs when a key
  // was given. `sort key` sorts pairs then projects the body at index 1.
  let [sorted, after_sorted] = call_builtin_one(state, "sort", accumulator)
  state = after_sorted
  if !found_key
    return [sorted, state]
  end
  let [projected, after_projected] = project_sorted_bodies(state, sorted)
  return [projected, after_projected]
end

// Appends the comprehension's `body` to `accumulator`, as `[key, body]` when
// the comprehension has a sort key and as `body` otherwise.
verb emit_comprehension_append(rows, node, body_node, accumulator, state)
  let [found_key, key_node] = ast_attr(rows, node, :key)
  let element = 0
  if found_key
    let [key_reg, after_key] = emit_expr(rows, key_node, state)
    state = after_key
    let [body_reg, after_body] = emit_expr(rows, body_node, state)
    state = after_body
    let [first, after_marshal] = marshal_arguments(state, [key_reg, body_reg])
    state = after_marshal
    let [pair, after_pair] = alloc_register(state)
    state = after_pair
    let [_, after_build] = emit_instruction(state, :Build_List, 0, pair, first, 2)
    state = after_build
    element = pair
  else
    let [body_reg, after_body] = emit_expr(rows, body_node, state)
    state = after_body
    element = body_reg
  end
  let [first, after_marshal] = marshal_arguments(state, [accumulator, element])
  state = after_marshal
  let [builtin, after_builtin] = add_builtin(state, "__list_append")
  state = after_builtin
  let [destination, after_destination] = alloc_register(state)
  state = after_destination
  let [_, after_append] = emit_instruction(state, :Builtin_Call, 0, destination, builtin, first)
  state = after_append
  let [_, after_move] = emit_instruction(state, :Move, 0, accumulator, destination, 0)
  state = after_move
  return state
end

// Calls a one-argument builtin, returning [result register, state].
verb call_builtin_one(state, builtin_name, argument)
  let [first, after_marshal] = marshal_arguments(state, [argument])
  state = after_marshal
  let [builtin, after_builtin] = add_builtin(state, builtin_name)
  state = after_builtin
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Builtin_Call, 0, dst, builtin, first)
  state = after_emit
  return [dst, state]
end

// Projects element 1 of every [key, body] pair in `sorted`, returning
// [register, state]. This is the tail of `sort key`.
verb project_sorted_bodies(state, sorted)
  let [projected, after_projected] = alloc_register(state)
  state = after_projected
  let [_, after_build] = emit_instruction(state, :Build_List, 0, projected, 0, 0)
  state = after_build
  let [one_reg, after_one] = load_constant(state, 1)
  state = after_one
  let [index_reg, after_index] = alloc_register(state)
  state = after_index
  let [_, after_zero] = emit_instruction(state, :Move, 0, index_reg, one_reg, 0)
  state = after_zero
  // Start from zero, not one; reload the zero constant for the loop start.
  let [zero_reg, after_zero_const] = load_constant(state, 0)
  state = after_zero_const
  let [_, after_start] = emit_instruction(state, :Move, 0, index_reg, zero_reg, 0)
  state = after_start

  let [length_reg, after_length] = alloc_register(state)
  state = after_length
  let [_, after_len] = emit_instruction(state, :Len, 0, length_reg, sorted, 0)
  state = after_len

  let loop_start = current_offset(state)
  let [condition_reg, after_condition] = alloc_register(state)
  state = after_condition
  let [_, after_lt] = emit_instruction(state, :Binary, 7, condition_reg, index_reg, length_reg)
  state = after_lt
  let [body_jump, after_body_jump] = emit_jump(state, :Branch, 0, condition_reg)
  state = after_body_jump
  let [exit_jump, after_exit_jump] = emit_jump(state, :Jump, 0, 0)
  state = after_exit_jump
  state = patch_jump(state, body_jump, current_offset(state))

  let [pair_reg, after_pair] = alloc_register(state)
  state = after_pair
  let [_, after_pair_at] = emit_instruction(state, :Collection_Value_At, 0, pair_reg, sorted, index_reg)
  state = after_pair_at
  let [element_reg, after_element] = alloc_register(state)
  state = after_element
  let [_, after_index] = emit_instruction(state, :Index, 0, element_reg, pair_reg, one_reg)
  state = after_index
  let [first, after_marshal] = marshal_arguments(state, [projected, element_reg])
  state = after_marshal
  let [append_builtin, after_builtin] = add_builtin(state, "__list_append")
  state = after_builtin
  let [next, after_next] = alloc_register(state)
  state = after_next
  let [_, after_append] = emit_instruction(state, :Builtin_Call, 0, next, append_builtin, first)
  state = after_append
  let [_, after_move] = emit_instruction(state, :Move, 0, projected, next, 0)
  state = after_move
  let [_, after_inc] = emit_instruction(state, :Binary, 0, index_reg, index_reg, one_reg)
  state = after_inc
  let [back_jump, after_back] = emit_jump(state, :Jump, 0, 0)
  state = after_back
  state = patch_jump(state, back_jump, loop_start)
  state = patch_jump(state, exit_jump, current_offset(state))
  return [projected, state]
end

verb emit_map_literal(rows, node, state)
  let entries = ast_children(rows, node, :entry)
  let registers = []
  for entry in entries
    let [found_key, key_node] = ast_attr(rows, entry, :key)
    let [found_value, value_node] = ast_attr(rows, entry, :value)
    if !found_key || !found_value
      return emit_error(state, "a map entry is missing its key or value")
    end
    let [key_reg, after_key] = emit_expr(rows, key_node, state)
    state = after_key
    let [value_reg, after_value] = emit_expr(rows, value_node, state)
    state = after_value
    registers = [@registers, key_reg]
    registers = [@registers, value_reg]
  end
  let [first, after_marshal] = marshal_arguments(state, registers)
  state = after_marshal
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Build_Map, 0, dst, first, len(entries))
  state = after_emit
  return [dst, state]
end

verb emit_index(rows, node, state)
  let [found_collection, collection_node] = ast_attr(rows, node, :collection)
  let [found_key, key_node] = ast_attr(rows, node, :key)
  if !found_collection || !found_key
    return emit_error(state, "an index is missing its collection or key")
  end
  let [collection_reg, after_collection] = emit_expr(rows, collection_node, state)
  state = after_collection
  let [key_reg, after_key] = emit_expr(rows, key_node, state)
  state = after_key
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Index, 0, dst, collection_reg, key_reg)
  state = after_emit
  return [dst, state]
end

// Field access lowers to the `__get_field` builtin with the receiver and the
// field name as a symbol.
verb emit_field(rows, node, state)
  let [found_receiver, receiver_node] = ast_attr(rows, node, :receiver)
  let [found_name, field_name] = ast_attr(rows, node, :name)
  if !found_receiver || !found_name
    return emit_error(state, "a field access is missing its receiver or name")
  end
  let [receiver_reg, after_receiver] = emit_expr(rows, receiver_node, state)
  state = after_receiver
  let [name_reg, after_name] = load_constant(state, to_symbol(field_name))
  state = after_name
  let [first, after_marshal] = marshal_arguments(state, [receiver_reg, name_reg])
  state = after_marshal
  let [builtin, after_builtin] = add_builtin(state, "__get_field")
  state = after_builtin
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Builtin_Call, 0, dst, builtin, first)
  state = after_emit
  return [dst, state]
end

// --- Control flow ------------------------------------------------------------

// Emits `if`/`elseif`/`else`. Each branch tests its condition, jumps past the
// rest on a match, and leaves its body's last value in the shared result
// register.
verb emit_if(rows, node, state)
  let [result, after_reg] = alloc_register(state)
  state = after_reg
  let branches = ast_children(rows, node, :branch)
  let end_patches = []
  let previous_skip = -1
  for branch in branches
    if previous_skip >= 0
      state = patch_jump(state, previous_skip, current_offset(state))
    end
    let [found_condition, condition_node] = ast_attr(rows, branch, :condition)
    if !found_condition
      return emit_error(state, "an if branch is missing its condition")
    end
    let [condition_reg, after_condition] = emit_expr(rows, condition_node, state)
    state = after_condition
    let [branch_jump, after_branch_jump] = emit_jump(state, :Branch, 0, condition_reg)
    state = after_branch_jump
    let [skip_jump, after_skip] = emit_jump(state, :Jump, 0, 0)
    state = after_skip
    state = patch_jump(state, branch_jump, current_offset(state))

    state = scope_enter(state)
    let body = ast_children(rows, branch, :body)
    let [body_reg, body_has_value, after_body] = emit_block(rows, body, state)
    state = after_body
    state = scope_leave(state)
    if body_has_value
      let [_, after_move] = emit_instruction(state, :Move, 0, result, body_reg, 0)
      state = after_move
    end
    let [end_jump, after_end_jump] = emit_jump(state, :Jump, 0, 0)
    state = after_end_jump
    end_patches = [@end_patches, end_jump]
    previous_skip = skip_jump
  end
  if previous_skip >= 0
    state = patch_jump(state, previous_skip, current_offset(state))
  end

  let [found_else, _] = ast_attr(rows, node, :has_else)
  if found_else
    state = scope_enter(state)
    let else_body = ast_children(rows, node, :else_body)
    let [else_reg, else_has_value, after_else] = emit_block(rows, else_body, state)
    state = after_else
    state = scope_leave(state)
    if else_has_value
      let [_, after_move] = emit_instruction(state, :Move, 0, result, else_reg, 0)
      state = after_move
    end
  end
  for patch in end_patches
    state = patch_jump(state, patch, current_offset(state))
  end
  return [result, state]
end

// Emits `while`: test the condition at the top, run the body, jump back.
verb emit_while(rows, node, state)
  let [result, after_reg] = alloc_register(state)
  state = after_reg
  let break_mark = len(state[6])
  state[9] = state[9] + 1
  let loop_depth = state[9]

  let loop_start = current_offset(state)
  state[8] = [@state[8], len(state[7])]

  let [found_condition, condition_node] = ast_attr(rows, node, :condition)
  if !found_condition
    return emit_error(state, "a while loop is missing its condition")
  end
  let [condition_reg, after_condition] = emit_expr(rows, condition_node, state)
  state = after_condition
  let [body_jump, after_body_jump] = emit_jump(state, :Branch, 0, condition_reg)
  state = after_body_jump
  let [exit_jump, after_exit_jump] = emit_jump(state, :Jump, 0, 0)
  state = after_exit_jump
  state = patch_jump(state, body_jump, current_offset(state))

  state = scope_enter(state)
  let body = ast_children(rows, node, :body)
  let [body_reg, body_has_value, after_body] = emit_block(rows, body, state)
  state = after_body
  state = scope_leave(state)
  if body_has_value
    let [_, after_move] = emit_instruction(state, :Move, 0, result, body_reg, 0)
    state = after_move
  end

  let [back_jump, after_back_jump] = emit_jump(state, :Jump, 0, 0)
  state = after_back_jump
  state = patch_jump(state, back_jump, loop_start)

  state = patch_loop_continues(state, loop_start)
  state = patch_jump(state, exit_jump, current_offset(state))
  state = patch_loop_breaks(state, break_mark)
  state[9] = loop_depth - 1
  return [result, state]
end

// Emits `for name in iterable`. A second name receives the zero-based index
// or map key. Destructuring headers and comprehensions arrive later.
verb emit_for(rows, node, state)
  let [found_iterable, iterable_node] = ast_attr(rows, node, :iterable)
  if !found_iterable
    return emit_error(state, "a for loop is missing its iterable")
  end
  let names = ast_children(rows, node, :name)
  let patterns = ast_children(rows, node, :pattern)
  let has_pattern = len(patterns) == 1
  if !has_pattern && len(names) != 1 && len(names) != 2
    return emit_error(state, "a for loop needs one or two names")
  end

  let [result, after_reg] = alloc_register(state)
  state = after_reg
  let [iterable, after_iterable] = emit_expr(rows, iterable_node, state)
  state = after_iterable

  let break_mark = len(state[6])
  state[9] = state[9] + 1
  let loop_depth = state[9]

  state = scope_enter(state)
  let [index_reg, after_index] = alloc_register(state)
  state = after_index
  let [zero_reg, after_zero_const] = load_constant(state, 0)
  state = after_zero_const
  let [_, after_zero] = emit_instruction(state, :Move, 0, index_reg, zero_reg, 0)
  state = after_zero

  let [length_reg, after_length] = alloc_register(state)
  state = after_length
  let [_, after_len] = emit_instruction(state, :Len, 0, length_reg, iterable, 0)
  state = after_len

  let loop_start = current_offset(state)
  state[8] = [@state[8], len(state[7])]

  let [condition_reg, after_condition] = alloc_register(state)
  state = after_condition
  let [_, after_lt] = emit_instruction(state, :Binary, 7, condition_reg, index_reg, length_reg)
  state = after_lt
  let [body_jump, after_body_jump] = emit_jump(state, :Branch, 0, condition_reg)
  state = after_body_jump
  let [exit_jump, after_exit_jump] = emit_jump(state, :Jump, 0, 0)
  state = after_exit_jump
  state = patch_jump(state, body_jump, current_offset(state))

  state = scope_enter(state)
  let [item_reg, after_item] = alloc_register(state)
  state = after_item
  let [_, after_value_at] = emit_instruction(state, :Collection_Value_At, 0, item_reg, iterable, index_reg)
  state = after_value_at
  if has_pattern
    state = bind_for_pattern(rows, patterns[0], item_reg, state)
  elseif len(names) == 2
    let [key_reg, after_key] = alloc_register(state)
    state = after_key
    let [_, after_key_at] = emit_instruction(state, :Collection_Key_At, 0, key_reg, iterable, index_reg)
    state = after_key_at
    state = declare_name(rows, names[0], key_reg, state)
    state = declare_name(rows, names[1], item_reg, state)
  else
    state = declare_name(rows, names[0], item_reg, state)
  end

  let body = ast_children(rows, node, :body)
  let [body_reg, body_has_value, after_body] = emit_block(rows, body, state)
  state = after_body
  state = scope_leave(state)
  if body_has_value
    let [_, after_move] = emit_instruction(state, :Move, 0, result, body_reg, 0)
    state = after_move
  end

  // `continue` advances the index first, so it targets the increment block.
  let increment_start = current_offset(state)
  state = patch_loop_continues(state, increment_start)

  let [one_reg, after_one] = load_constant(state, 1)
  state = after_one
  let [_, after_inc] = emit_instruction(state, :Binary, 0, index_reg, index_reg, one_reg)
  state = after_inc

  let [back_jump, after_back] = emit_jump(state, :Jump, 0, 0)
  state = after_back
  state = patch_jump(state, back_jump, loop_start)

  state = patch_jump(state, exit_jump, current_offset(state))
  state = patch_loop_breaks(state, break_mark)
  state = scope_leave(state)
  state[9] = loop_depth - 1
  return [result, state]
end

// Declares the single-part name of a LoopName node at `reg`.
verb declare_name(rows, name_node, reg, state)
  let [found, binding_name] = ast_attr(rows, name_node, :name)
  if !found
    return state
  end
  return declare_local(state, binding_name, reg, false)
end

// Binds a for-header destructuring pattern against the item in `value_reg`.
// A list pattern scatters by position, a map pattern projects named columns,
// and a wildcard discards the item.
verb bind_for_pattern(rows, pattern, value_reg, state)
  let kind = ast_kind(rows, pattern)
  if kind == :Wildcard_Pattern
    return state
  end
  if kind == :Binding_Pattern
    let [found_name, binding_name] = ast_attr(rows, pattern, :name)
    if found_name
      return declare_local(state, binding_name, value_reg, false)
    end
    return state
  end
  if kind == :List_Pattern
    return bind_list_pattern(rows, pattern, value_reg, state)
  end
  if kind == :Map_Pattern
    return bind_map_pattern(rows, pattern, value_reg, state)
  end
  return emit_error(state, "a for loop pattern must be a list, map, or wildcard")[1]
end

// Scatters a list pattern's binding elements by position. A wildcard element
// still consumes a slot.
verb bind_list_pattern(rows, pattern, value_reg, state)
  let elements = ast_children(rows, pattern, :element)
  let position = 0
  for element in elements
    let element_kind = ast_kind(rows, element)
    if element_kind == :Binding_Pattern
      let [found_name, binding_name] = ast_attr(rows, element, :name)
      let [index_reg, after_index] = load_constant(state, position)
      state = after_index
      let [column, after_column] = alloc_register(state)
      state = after_column
      let [_, after_index_op] = emit_instruction(
        state, :Index, 0, column, value_reg, index_reg,
      )
      state = after_index_op
      if found_name
        state = declare_local(state, binding_name, column, false)
      end
    elseif element_kind == :Wildcard_Pattern
      // Consumes the slot with no binding.
    elseif element_kind == :Optional_Pattern
      state = bind_optional_scatter(rows, element, value_reg, position, false, state)
    elseif element_kind == :Rest_Pattern
      let [found_name, rest_name] = ast_attr(rows, element, :name)
      if found_name
        state = bind_rest_scatter(rows, element, value_reg, position, false, state, rest_name)
      end
    else
      state = emit_error(state, "a for list pattern needs names or wildcards")[1]
    end
    position = position + 1
  end
  return state
end

// Projects a map pattern's named columns, indexing each binding by its key
// symbol. `{work}` binds column :work.
verb bind_map_pattern(rows, pattern, value_reg, state)
  let entries = ast_children(rows, pattern, :entry)
  for entry in entries
    let [found_key, key_node] = ast_attr(rows, entry, :key)
    if !found_key
      return emit_error(state, "a map pattern entry is missing its key")[1]
    end
    let [found_key_name, key_name] = ast_attr(rows, key_node, :name)
    if !found_key_name
      return emit_error(state, "a map pattern key is missing its name")[1]
    end
    let [key_reg, after_key] = load_constant(state, to_symbol(key_name))
    state = after_key
    let [column, after_column] = alloc_register(state)
    state = after_column
    let [_, after_index] = emit_instruction(state, :Index, 0, column, value_reg, key_reg)
    state = after_index
    let [found_pattern, binding] = ast_attr(rows, entry, :pattern)
    if found_pattern && ast_kind(rows, binding) == :Binding_Pattern
      let [found_name, binding_name] = ast_attr(rows, binding, :name)
      if found_name
        state = declare_local(state, binding_name, column, false)
      end
    end
  end
  return state
end

// Patches every `continue` recorded for the innermost active loop to `target`
// and pops its mark.
verb patch_loop_continues(state, target)
  let marks = state[8]
  let mark = marks[len(marks) - 1]
  let patches = state[7]
  let index = mark
  while index < len(patches)
    state = patch_jump(state, patches[index], target)
    index = index + 1
  end
  state[7] = __list_slice(patches, 0, mark)
  state[8] = __list_slice(marks, 0, len(marks) - 1)
  return state
end

// Patches every `break` recorded since `mark` to the current offset and drops
// them.
verb patch_loop_breaks(state, mark)
  let patches = state[6]
  let index = mark
  while index < len(patches)
    state = patch_jump(state, patches[index], current_offset(state))
    index = index + 1
  end
  state[6] = __list_slice(patches, 0, mark)
  return state
end

// `require` fails the task with E_REQUIRE when its condition is false. It
// lowers to the `require` builtin.
verb emit_require(rows, node, state)
  let [found_condition, condition_node] = ast_attr(rows, node, :condition)
  if !found_condition
    return emit_error(state, "a require is missing its condition")
  end
  let [condition_reg, after_condition] = emit_expr(rows, condition_node, state)
  state = after_condition
  let [builtin, after_builtin] = add_builtin(state, "require")
  state = after_builtin
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Builtin_Call, 0, dst, builtin, condition_reg)
  state = after_emit
  return [dst, state]
end

// `try ... catch ... finally ... end`. A Push_Handler installs a catch
// target; the body runs; on normal completion the handler pops and the result
// jumps past every catch. On error the VM transfers to the innermost catch
// whose code matches (or the first with no code), binding the error when the
// clause names one. With no match the error re-raises. A finally body runs on
// every exit path.
verb emit_try(rows, node, state)
  let [result, after_result] = alloc_register(state)
  state = after_result
  let [error_register, after_error] = alloc_register(state)
  state = after_error
  let [empty_reg, after_empty] = load_constant(state, empty_relation_value())
  state = after_empty
  let [_, after_init] = emit_instruction(state, :Move, 0, error_register, empty_reg, 0)
  state = after_init

  let [handler_push, after_handler_push] = emit_instruction(state, :Push_Handler, 0, 0, error_register, 0)
  state = after_handler_push
  let [has_finally, _] = ast_attr(rows, node, :has_finally)
  let finally_push = -1
  if has_finally
    let [push, after_push] = emit_instruction(state, :Push_Finally, 0, 0, 0, 0)
    state = after_push
    finally_push = push
  end

  state = scope_enter(state)
  let body = ast_children(rows, node, :body)
  let [body_reg, body_has_value, after_body] = emit_block(rows, body, state)
  state = after_body
  state = scope_leave(state)
  if body_has_value
    let [_, after_move] = emit_instruction(state, :Move, 0, result, body_reg, 0)
    state = after_move
  end
  let [_, after_pop] = emit_instruction(state, :Pop_Handler, 0, 0, 0, 0)
  state = after_pop
  if has_finally
    let [_, after_finally_pop] = emit_instruction(state, :Pop_Handler, 0, 0, 0, 0)
    state = after_finally_pop
  end
  let [normal_jump, after_normal_jump] = emit_jump(state, :Jump, 0, 0)
  state = after_normal_jump

  state = patch_handler_target(state, handler_push, current_offset(state))

  let body_jumps = []
  let catch_finally_pushes = []
  let previous_false = -1
  let catches = ast_children(rows, node, :catch_clause)
  for clause in catches
    if previous_false >= 0
      state = patch_jump(state, previous_false, current_offset(state))
      previous_false = -1
    end
    state = scope_enter(state)
    let [has_code, clause_code] = ast_attr(rows, clause, :code)
    let test = 0
    if has_code
      let [actual, after_actual] = emit_error_code_field(error_register, state)
      state = after_actual
      let [expected, after_expected] = load_constant(state, from_literal(clause_code)[:value])
      state = after_expected
      let [test_reg, after_test] = alloc_register(state)
      state = after_test
      // 11 is Error_Is_A: a clause catches its code and every descendant.
      let [_, after_test] = emit_instruction(state, :Binary, 11, test_reg, actual, expected)
      state = after_test
      test = test_reg
    else
      let [true_reg, after_true] = load_constant(state, true)
      state = after_true
      test = true_reg
    end

    let [branch, after_branch] = emit_jump(state, :Branch, 0, test)
    state = after_branch
    let [skip_all, after_skip_all] = emit_jump(state, :Jump, 0, 0)
    state = after_skip_all
    previous_false = skip_all
    state = patch_jump(state, branch, current_offset(state))

    let [has_name, clause_name] = ast_attr(rows, clause, :name)
    if has_name
      let [binding, after_binding] = alloc_register(state)
      state = after_binding
      let [_, after_move] = emit_instruction(state, :Move, 0, binding, error_register, 0)
      state = after_move
      state = declare_local(state, clause_name, binding, false)
    end
    if has_finally
      let [push, after_push] = emit_instruction(state, :Push_Finally, 1, 0, 0, 0)
      state = after_push
      catch_finally_pushes = [@catch_finally_pushes, push]
    end
    let clause_body = ast_children(rows, clause, :body)
    let [clause_reg, clause_has_value, after_clause] = emit_block(rows, clause_body, state)
    state = after_clause
    if has_finally
      let [_, after_catch_pop] = emit_instruction(state, :Pop_Handler, 0, 0, 0, 0)
      state = after_catch_pop
    end
    state = scope_leave(state)
    if clause_has_value
      let [_, after_move] = emit_instruction(state, :Move, 0, result, clause_reg, 0)
      state = after_move
    end
    let [clause_jump, after_clause_jump] = emit_jump(state, :Jump, 0, 0)
    state = after_clause_jump
    body_jumps = [@body_jumps, clause_jump]
  end

  // No clause matched: run finally, then re-raise.
  if previous_false >= 0
    state = patch_jump(state, previous_false, current_offset(state))
  end
  if has_finally
    let finally_body = ast_children(rows, node, :finally_body)
    state = emit_guarded_finally(rows, finally_body, result, state)
  end
  let [_, after_reraise] = emit_instruction(state, :Raise, 0, error_register, -1, -1)
  state = after_reraise

  let finally_target = current_offset(state)
  state = patch_jump(state, normal_jump, finally_target)
  for jump in body_jumps
    state = patch_jump(state, jump, finally_target)
  end
  for push in catch_finally_pushes
    state = patch_handler_target(state, push, finally_target)
  end
  if has_finally
    if finally_push >= 0
      state = patch_handler_target(state, finally_push, finally_target)
    end
    let finally_body = ast_children(rows, node, :finally_body)
    state = emit_guarded_finally(rows, finally_body, result, state)
    let [_, after_resume] = emit_instruction(state, :Resume_Return, 0, 0, 0, 0)
    state = after_resume
  end
  return [result, state]
end

// Reads `error.code` from `error_reg`, returning [register, state].
verb emit_error_code_field(error_reg, state)
  let [symbol_reg, after_symbol] = load_constant(state, to_symbol("code"))
  state = after_symbol
  let [first, after_marshal] = marshal_arguments(state, [error_reg, symbol_reg])
  state = after_marshal
  let [builtin, after_builtin] = add_builtin(state, "__get_field")
  state = after_builtin
  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_call] = emit_instruction(state, :Builtin_Call, 0, dst, builtin, first)
  state = after_call
  return [dst, state]
end

// Runs a finally body while guarding against it raising: an error from the
// finally is caught and re-raised after the pop.
verb emit_guarded_finally(rows, body, result, state)
  let [guard_error, after_guard_error] = alloc_register(state)
  state = after_guard_error
  let [guard_push, after_guard_push] = emit_instruction(state, :Push_Handler, 0, 0, guard_error, 0)
  state = after_guard_push
  state = scope_enter(state)
  let [finally_reg, finally_has_value, after_finally] = emit_block(rows, body, state)
  state = after_finally
  state = scope_leave(state)
  if finally_has_value
    let [_, after_move] = emit_instruction(state, :Move, 0, result, finally_reg, 0)
    state = after_move
  end
  let [_, after_pop] = emit_instruction(state, :Pop_Handler, 0, 0, 0, 0)
  state = after_pop
  let [skip_jump, after_skip] = emit_jump(state, :Jump, 0, 0)
  state = after_skip
  state = patch_handler_target(state, guard_push, current_offset(state))
  let [_, after_raise] = emit_instruction(state, :Raise, 0, guard_error, -1, -1)
  state = after_raise
  state = patch_jump(state, skip_jump, current_offset(state))
  return state
end

// Sets the absolute catch/finally target of a Push_Handler or Push_Finally.
verb patch_handler_target(state, at, target)
  let code = state[0]
  let instruction = code[at]
  instruction[:a] = target
  code[at] = instruction
  state[0] = code
  // A handler target is a merge point reached by an implicit raise, so no
  // constant cached on the protected path is known to be loaded here.
  state = forget_constants(state)
  return state
end

verb emit_begin(rows, node, state)
  let body = ast_children(rows, node, :body)
  let [last_reg, _, after_body] = emit_block(rows, body, state)
  return [last_reg, after_body]
end
verb emit_break(state)
  if state[9] == 0
    return emit_error(state, "break outside a loop")
  end
  let [offset, after_jump] = emit_jump(state, :Jump, 0, 0)
  state = after_jump
  state[6] = [@state[6], offset]
  return [-1, state]
end

verb emit_continue(state)
  if len(state[8]) == 0
    return emit_error(state, "continue outside a loop")
  end
  let [offset, after_jump] = emit_jump(state, :Jump, 0, 0)
  state = after_jump
  state[7] = [@state[7], offset]
  return [-1, state]
end

// Emits a body of expressions in order, tracking the last value-producing
// expression. Returns [last register, has value, state]. The register is only
// meaningful when `has value` is true.
verb emit_block(rows, body, state)
  let last_reg = -1
  let has_value = false
  for expression in body
    let [reg, expression_has_value, after_expr] = emit_expr_value(rows, expression, state)
    state = after_expr
    if expression_has_value
      last_reg = reg
      has_value = true
    end
  end
  return [last_reg, has_value, state]
end

// Wraps emit_expr so a statement that produces no value (break, continue, a
// bare return) is distinguishable. emit_expr signals "no value" by returning
// register -1 with the second element still true, so this reads the register.
verb emit_expr_value(rows, node, state)
  let [reg, after_expr] = emit_expr(rows, node, state)
  if reg < 0
    return [-1, false, after_expr]
  end
  return [reg, true, after_expr]
end

// A call to a reserved verb, or to a registered builtin. Builtin names are
// recognized by the runtime table, so anything not a known verb falls
// through to Builtin_Call.
verb emit_call(rows, node, state)
  let [found_callee, callee_node] = ast_attr(rows, node, :callee)
  if !found_callee
    return emit_error(state, "a call is missing its callee")
  end
  let callee_kind = ast_kind(rows, callee_node)
  // `:selector(role: value, ...)` is a role dispatch: the selector plus named
  // roles pick the method at run time.
  if callee_kind == :Symbol_Literal
    return emit_role_dispatch(rows, callee_node, node, state)
  end
  if callee_kind != :Name
    return emit_error(state, "a computed callee needs a later slice")
  end
  let [named, callee_name] = join_name(rows, callee_node)
  if !named
    return emit_error(state, "a callee is missing its name")
  end
  let args = ast_children(rows, node, :arg)

  // `len` is a compiler-recognized form rather than a runtime builtin.
  if callee_name == "len"
    if len(args) != 1
      return emit_error(state, "len expects one argument")
    end
    let [found_expr, arg_expr] = ast_attr(rows, args[0], :expr)
    if !found_expr
      return emit_error(state, "a call argument is missing its expression")
    end
    let [operand, after_operand] = emit_expr(rows, arg_expr, state)
    state = after_operand
    let [dst, after_reg] = alloc_register(state)
    state = after_reg
    let [_, after_emit] = emit_instruction(state, :Len, 0, dst, operand, 0)
    state = after_emit
    return [dst, state]
  end

  // A lexically visible local function value takes precedence: `add5(3)` calls
  // the closure bound to `add5`. This mirrors the Odin emitter, which resolves
  // a local before builtins and verb dispatch.
  let [is_local_function, local_reg] = resolve_local(state, callee_name)
  if is_local_function
    let registers = []
    for arg in args
      let [found_expr, arg_expr] = ast_attr(rows, arg, :expr)
      if !found_expr
        return emit_error(state, "a call argument is missing its expression")
      end
      let [arg_reg, after_arg] = emit_expr(rows, arg_expr, state)
      state = after_arg
      registers = [@registers, arg_reg]
    end
    let [first, after_marshal] = marshal_arguments(state, registers)
    state = after_marshal
    let [dst, after_reg] = alloc_register(state)
    state = after_reg
    let [_, after_emit] = emit_instruction(
      state, :Call_Value, len(registers), dst, local_reg, first,
    )
    state = after_emit
    return [dst, state]
  end

  let [found_function, function_index] = find_function(state, callee_name)
  if found_function
    let registers = []
    for arg in args
      let [found_expr, arg_expr] = ast_attr(rows, arg, :expr)
      if !found_expr
        return emit_error(state, "a call argument is missing its expression")
      end
      let [arg_reg, after_arg] = emit_expr(rows, arg_expr, state)
      state = after_arg
      registers = [@registers, arg_reg]
    end
    let [first, after_marshal] = marshal_arguments(state, registers)
    state = after_marshal
    // An overloaded or restricted verb cannot be called directly: every
    // declaration must be considered and restrictions enforced, which is what
    // Positional_Dispatch does. A directly callable verb takes the fast path.
    if verb_needs_dispatch(state, callee_name)
      return emit_positional_dispatch(callee_name, first, len(registers), state)
    end
    let [dst, after_reg] = alloc_register(state)
    state = after_reg
    let [_, after_emit] = emit_instruction(
      state, :Call, len(registers), dst, function_index, first,
    )
    state = after_emit
    return [dst, state]
  end

  // `invoke(selector, roles)` is a compiler-recognized dynamic dispatch, not
  // a builtin. The first argument is the selector, the second a role map.
  if callee_name == "invoke"
    if len(args) != 2
      return emit_error(state, "invoke expects a selector and a role map")
    end
    let [found_selector, selector_node] = ast_attr(rows, args[0], :expr)
    let [found_roles, roles_node] = ast_attr(rows, args[1], :expr)
    if !found_selector || !found_roles
      return emit_error(state, "invoke is missing its selector or roles")
    end
    let [selector, after_selector] = emit_expr(rows, selector_node, state)
    state = after_selector
    let [roles_reg, after_roles] = emit_expr(rows, roles_node, state)
    state = after_roles
    let [dst, after_dst] = alloc_register(state)
    state = after_dst
    let [_, after_dispatch] = emit_instruction(state, :Dynamic_Dispatch, 0, dst, selector, roles_reg)
    state = after_dispatch
    return [dst, state]
  end

  // `commit` and `suspend` are compiler-recognized VM ops, not builtins.
  if callee_name == "commit"
    if len(args) != 0
      return emit_error(state, "commit expects no arguments")
    end
    let [_, after_emit] = emit_instruction(state, :Commit, 0, 0, 0, 0)
    state = after_emit
    return [-1, state]
  end

  // `mailbox_recv` is a VM op rather than a runtime builtin: it suspends.
  if callee_name == "mailbox_recv"
    return emit_mailbox_recv(rows, args, state)
  end

  // Builtins are a fixed global set, so at compile time the emitter can tell
  // a builtin call from anything else. A call with a query variable or
  // wildcard is always a scan. Anything else that is not a builtin is a rule
  // or relation predicate, which is a scan whose bound arguments match cells.
  if call_has_query(rows, args)
    return emit_relation_query(rows, callee_name, args, state)
  end
  // The builtin set is fixed and global, so __is_builtin answers at emit time
  // in the emitter's own execution, not in the target program.
  if !__is_builtin(to_symbol(callee_name))
    return emit_relation_query(rows, callee_name, args, state)
  end

  return emit_builtin_call(rows, args, callee_name, state)
end

// Reports whether any argument is a query variable or wildcard, which marks
// the call as a relation scan rather than a function or builtin call.
verb call_has_query(rows, args)
  for arg in args
    let [found_expr, arg_expr] = ast_attr(rows, arg, :expr)
    if !found_expr
      continue
    end
    let kind = ast_kind(rows, arg_expr)
    if kind == :Query_Variable || kind == :Wildcard
      return true
    end
  end
  return false
end

// Emits a relation scan against the named relation, resolving the name at
// scan time. Named query variables become output columns; wildcards match
// anything; any other expression is a bound value that must equal the cell.
// A scan with no output columns is a predicate test returning a boolean.
verb emit_relation_query(rows, relation_name, args, state)
  let column_names = []
  let cells = []
  let has_output = false
  let index = 0
  for arg in args
    let [found_expr, arg_expr] = ast_attr(rows, arg, :expr)
    if !found_expr
      return emit_error(state, "a query argument is missing its expression")
    end
    let kind = ast_kind(rows, arg_expr)
    if kind == :Query_Variable
      let [found_name, variable_name] = ast_attr(rows, arg_expr, :name)
      if !found_name
        return emit_error(state, "a query variable is missing its name")
      end
      let [reg, after_reg] = alloc_register(state)
      state = after_reg
      column_names = [@column_names, to_symbol(variable_name)]
      cells = [@cells, {:kind -> :Output, :operand -> reg}]
      has_output = true
    elseif kind == :Wildcard
      column_names = [@column_names, generated_column(index)]
      cells = [@cells, {:kind -> :Wildcard, :operand -> 0}]
    else
      let [reg, after_reg] = emit_expr(rows, arg_expr, state)
      state = after_reg
      column_names = [@column_names, generated_column(index)]
      cells = [@cells, {:kind -> :Bind, :operand -> reg}]
    end
    index = index + 1
  end

  let pattern_index = len(state[14])
  let pattern = {:name -> relation_name, :columns -> column_names, :cells -> cells}
  state[14] = [@state[14], pattern]

  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let op = :Scan_Exists
  if has_output
    op = :Scan_Collect
  end
  let [_, after_emit] = emit_instruction(state, op, 0, dst, pattern_index, 0)
  state = after_emit
  return [dst, state]
end

// `:selector(role: value, ...)` lowers to a Dispatch with a spec naming the
// selector and each role's register. Every argument must use an explicit role.
// Whether `verb_name` is declared more than once or has any restricted
// parameter, in which case a call must go through Positional_Dispatch.
verb verb_needs_dispatch(state, verb_name)
  let counts = state[17]
  if index_or(counts, verb_name, 0) > 1
    return true
  end
  let restricted = state[18]
  return index_or(restricted, verb_name, false)
end

// Emits Positional_Dispatch for a verb name. The runtime selects the
// declaration whose restrictions and arity match and enforces them.
verb emit_positional_dispatch(verb_name, first_argument, argument_count, state)
  let [selector, after_selector] = load_constant(state, to_symbol(verb_name))
  state = after_selector
  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_dispatch] = emit_instruction(
    state, :Positional_Dispatch, argument_count, dst, selector, first_argument,
  )
  state = after_dispatch
  return [dst, state]
end

verb emit_role_dispatch(rows, callee_node, node, state)
  let [found_selector, selector_name] = ast_attr(rows, callee_node, :name)
  if !found_selector
    return emit_error(state, "a dispatch selector is missing its name")
  end
  let args = ast_children(rows, node, :arg)
  let roles = []
  for arg in args
    let [found_role, role_name] = ast_attr(rows, arg, :role)
    if !found_role
      return emit_error(state, "dispatch arguments must use explicit role names")
    end
    let [found_expr, arg_expr] = ast_attr(rows, arg, :expr)
    if !found_expr
      return emit_error(state, "a dispatch argument is missing its expression")
    end
    let [arg_reg, after_arg] = emit_expr(rows, arg_expr, state)
    state = after_arg
    roles = [@roles, {:role -> role_name, :register -> arg_reg}]
  end
  let spec_index = len(state[15])
  state[15] = [@state[15], {:selector -> selector_name, :roles -> roles}]
  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_dispatch] = emit_instruction(state, :Dispatch, 0, dst, spec_index, 0)
  state = after_dispatch
  return [dst, state]
end

// A call to a runtime builtin: marshal the arguments and emit Builtin_Call
// with the builtin's slot in the program's builtin table.
verb emit_builtin_call(rows, args, callee_name, state)
  let registers = []
  for arg in args
    let [found_expr, arg_expr] = ast_attr(rows, arg, :expr)
    if !found_expr
      return emit_error(state, "a call argument is missing its expression")
    end
    let [arg_reg, after_arg] = emit_expr(rows, arg_expr, state)
    state = after_arg
    registers = [@registers, arg_reg]
  end
  let [first, after_marshal] = marshal_arguments(state, registers)
  state = after_marshal
  let [builtin, after_builtin] = add_builtin(state, callee_name)
  state = after_builtin
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(
    state, :Builtin_Call, len(registers), dst, builtin, first,
  )
  state = after_emit
  return [dst, state]
end

// `assert R(a, b)` and `retract R(a, b)` build a single-row relation value
// with generated column names and lower to the runtime write builtin, which
// resolves the relation by name at execution time.
verb emit_relation_write(rows, node, assert_write, state)
  let [found_atom, atom] = ast_attr(rows, node, :atom)
  if !found_atom || ast_kind(rows, atom) != :Call
    return emit_error(state, "assert and retract need a relation atom")
  end
  let [found_callee, callee_node] = ast_attr(rows, atom, :callee)
  if !found_callee || ast_kind(rows, callee_node) != :Name
    return emit_error(state, "assert and retract need a relation name")
  end
  let [named, relation_name] = join_name(rows, callee_node)
  if !named
    return emit_error(state, "a relation write is missing its relation name")
  end

  let args = ast_children(rows, atom, :arg)

  // `retract R(x, _)` retracts every matching row, so a wildcard routes to
  // the Retract_Where op with a scan pattern rather than a single-row write.
  if !assert_write
    let has_wildcard = false
    for arg in args
      let [found_expr, arg_expr] = ast_attr(rows, arg, :expr)
      if found_expr && ast_kind(rows, arg_expr) == :Wildcard
        has_wildcard = true
        break
      end
    end
    if has_wildcard
      return emit_retract_where(rows, args, relation_name, state)
    end
  end

  let heading = []
  let registers = []
  let index = 0
  for arg in args
    let [found_expr, arg_expr] = ast_attr(rows, arg, :expr)
    if !found_expr
      return emit_error(state, "a relation write argument is missing its expression")
    end
    heading = [@heading, generated_column(index)]
    let [arg_reg, after_arg] = emit_expr(rows, arg_expr, state)
    state = after_arg
    registers = [@registers, arg_reg]
    index = index + 1
  end

  // The row value is built with the relation-literal builtin over a
  // single-row list, so the shape is known at run time, then the write
  // builtin resolves the relation by name.
  let [rows_reg, after_rows] = build_single_row(state, registers)
  state = after_rows
  let [heading_reg, after_heading] = load_constant(state, heading)
  state = after_heading
  let [literal_first, after_literal_marshal] = marshal_arguments(
    state, [heading_reg, rows_reg],
  )
  state = after_literal_marshal
  let [literal_builtin, after_literal_builtin] = add_builtin(state, "__relation_literal")
  state = after_literal_builtin
  let [row_value, after_row_value] = alloc_register(state)
  state = after_row_value
  let [_, after_literal] = emit_instruction(
    state, :Builtin_Call, 0, row_value, literal_builtin, literal_first,
  )
  state = after_literal

  let [name_reg, after_name] = load_constant(state, to_symbol(relation_name))
  state = after_name
  let [first, after_marshal] = marshal_arguments(state, [name_reg, row_value])
  state = after_marshal
  let builtin_name = "__relation_assert"
  if !assert_write
    builtin_name = "__relation_retract"
  end
  let [builtin, after_builtin] = add_builtin(state, builtin_name)
  state = after_builtin
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Builtin_Call, 0, dst, builtin, first)
  state = after_emit
  return [dst, state]
end

// `mailbox_recv([receivers])` or `mailbox_recv([receivers], timeout)` suspends
// until a message arrives. Lowers to the Mailbox_Recv op.
// `raise CODE, message, value` lowers to the Raise op. The message and value
// are optional; -1 marks absent, matching the VM's encoding.
verb emit_raise(rows, node, state)
  let parts = ast_children(rows, node, :part)
  if len(parts) == 0 || len(parts) > 3
    return emit_error(state, "raise expects an error code and optional message and value")
  end
  let [code_reg, after_code] = emit_expr(rows, parts[0], state)
  state = after_code
  let message_reg = -1
  if len(parts) > 1
    let [reg, after_message] = emit_expr(rows, parts[1], state)
    state = after_message
    message_reg = reg
  end
  let value_reg = -1
  if len(parts) > 2
    let [reg, after_value] = emit_expr(rows, parts[2], state)
    state = after_value
    value_reg = reg
  end
  let [_, after_emit] = emit_instruction(state, :Raise, 0, code_reg, message_reg, value_reg)
  state = after_emit
  return [-1, state]
end

// `dom<tag attrs>children</tag>` lowers to the dom_element builtin with the
// tag string, an attributes map, and a children list.
verb emit_dom_element(rows, node, state)
  let [found_tag, tag] = ast_attr(rows, node, :tag)
  if !found_tag
    return emit_error(state, "a dom element is missing its tag")
  end
  let [tag_reg, after_tag] = load_constant(state, tag)
  state = after_tag

  let attributes = ast_children(rows, node, :attribute)
  let registers = []
  for attribute in attributes
    let [found_name, attribute_name] = ast_attr(rows, attribute, :name)
    if !found_name
      return emit_error(state, "a dom attribute is missing its name")
    end
    let [name_reg, after_name] = load_constant(state, attribute_name)
    state = after_name
    let [found_value, value_node] = ast_attr(rows, attribute, :value)
    let value_reg = 0
    if found_value
      let [emitted, after_value] = emit_expr(rows, value_node, state)
      state = after_value
      value_reg = emitted
    else
      let [emitted, after_true] = load_constant(state, true)
      state = after_true
      value_reg = emitted
    end
    registers = [@registers, name_reg]
    registers = [@registers, value_reg]
  end
  let [attr_first, after_attr_marshal] = marshal_arguments(state, registers)
  state = after_attr_marshal
  let [attributes_reg, after_attributes] = alloc_register(state)
  state = after_attributes
  let [_, after_map] = emit_instruction(
    state, :Build_Map, 0, attributes_reg, attr_first, len(attributes),
  )
  state = after_map

  let children = ast_children(rows, node, :child)
  let [children_reg, after_children] = emit_list_of_nodes(rows, children, state)
  state = after_children

  let [first, after_marshal] = marshal_arguments(
    state, [tag_reg, attributes_reg, children_reg],
  )
  state = after_marshal
  let [builtin, after_builtin] = add_builtin(state, "dom_element")
  state = after_builtin
  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_call] = emit_instruction(state, :Builtin_Call, 3, dst, builtin, first)
  state = after_call
  return [dst, state]
end

verb emit_dom_text(rows, node, state)
  let [found_text, text] = ast_attr(rows, node, :text)
  if !found_text
    return emit_error(state, "a dom text node is missing its text")
  end
  let [text_reg, after_text] = load_constant(state, text)
  state = after_text
  let [builtin, after_builtin] = add_builtin(state, "dom_text")
  state = after_builtin
  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_call] = emit_instruction(state, :Builtin_Call, 1, dst, builtin, text_reg)
  state = after_call
  return [dst, state]
end

// Builds a list from already-parsed child nodes, returning [register, state].
// A child is an element, text, an interpolation, or a splice (`{@xs}`), which
// contributes its elements rather than one child.
verb emit_list_of_nodes(rows, children, state)
  let has_splice = false
  for child in children
    if ast_kind(rows, child) == :Splice
      has_splice = true
    end
  end
  let registers = []
  for child in children
    if ast_kind(rows, child) == :Splice
      let [found_value, value_node] = ast_attr(rows, child, :value)
      if !found_value
        return [0, emit_error(state, "a splice is missing its value")[1]]
      end
      let [reg, after_spliced] = emit_expr(rows, value_node, state)
      state = after_spliced
      registers = [@registers, reg]
      continue
    end
    let [reg, after_child] = emit_expr(rows, child, state)
    state = after_child
    if has_splice
      let [wrapped, after_wrap] = emit_singleton_list(state, reg)
      state = after_wrap
      registers = [@registers, wrapped]
    else
      registers = [@registers, reg]
    end
  end
  if has_splice
    let [first, after_marshal] = marshal_arguments(state, registers)
    state = after_marshal
    let [builtin, after_builtin] = add_builtin(state, "__list_concat")
    state = after_builtin
    let [dst, after_dst] = alloc_register(state)
    state = after_dst
    let [_, after_call] = emit_instruction(
      state, :Builtin_Call, len(registers), dst, builtin, first,
    )
    state = after_call
    return [dst, state]
  end
  let [first, after_marshal] = marshal_arguments(state, registers)
  state = after_marshal
  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_build] = emit_instruction(state, :Build_List, 0, dst, first, len(registers))
  state = after_build
  return [dst, state]
end

// `match subject` with `case pattern [if guard] ... end`. Each case tests its
// pattern, running the body and jumping past the rest on success, or falling
// through to the next case on failure.
//
// Case-failure jumps are collected on a stack in state[16] so nested matches
// keep their own lists. A case boundary patches and clears the list for the
// current match.
verb emit_match(rows, node, state)
  let [found_subject, subject_node] = ast_attr(rows, node, :value)
  if !found_subject
    return emit_error(state, "a match is missing its subject")
  end
  let [subject, after_subject] = emit_expr(rows, subject_node, state)
  state = after_subject
  let [result, after_result] = alloc_register(state)
  state = after_result

  // Push this match's failure-jump list.
  state[16] = [@state[16], []]

  let cases = ast_children(rows, node, :case)
  let end_patches = []
  for case_node in cases
    state = match_clear_failures(state)
    state = scope_enter(state)
    let [found_pattern, pattern] = ast_attr(rows, case_node, :pattern)
    if !found_pattern
      state = scope_leave(state)
      return emit_error(state, "a match case is missing its pattern")
    end
    state = emit_match_pattern(rows, subject, pattern, state)

    let [found_guard, guard_node] = ast_attr(rows, case_node, :guard)
    if found_guard
      let [guard, after_guard] = emit_expr(rows, guard_node, state)
      state = after_guard
      state = emit_match_fail_test(guard, state)
    end

    let body = ast_children(rows, case_node, :body)
    let [body_reg, body_has_value, after_body] = emit_block(rows, body, state)
    state = after_body
    state = scope_leave(state)
    if body_has_value
      let [_, after_move] = emit_instruction(state, :Move, 0, result, body_reg, 0)
      state = after_move
    end
    let [end_jump, after_end_jump] = emit_jump(state, :Jump, 0, 0)
    state = after_end_jump
    end_patches = [@end_patches, end_jump]
  end

  // Patch any failures left after the last case to fall out of the match.
  state = match_clear_failures(state)
  // Pop this match's list (now empty).
  state[16] = __list_slice(state[16], 0, len(state[16]) - 1)

  for patch in end_patches
    state = patch_jump(state, patch, current_offset(state))
  end
  return [result, state]
end

// Appends a test that falls through to the next case when `test` is false:
// branch past a jump when true, and record the jump for the case boundary.
verb emit_match_fail_test(test, state)
  let [branch, after_branch] = emit_jump(state, :Branch, 0, test)
  state = after_branch
  let [skip, after_skip] = emit_jump(state, :Jump, 0, 0)
  state = after_skip
  let stack = state[16]
  let top = stack[len(stack) - 1]
  top = [@top, skip]
  stack = [@__list_slice(stack, 0, len(stack) - 1), top]
  state[16] = stack
  state = patch_jump(state, branch, current_offset(state))
  return state
end

// Patches every recorded failure jump to the current offset and clears the
// innermost match's list. Call at each case boundary.
verb match_clear_failures(state)
  let stack = state[16]
  if len(stack) == 0
    return state
  end
  let top = stack[len(stack) - 1]
  for patch in top
    state = patch_jump(state, patch, current_offset(state))
  end
  // Replace the innermost list with an empty one, without indexed assignment.
  let replaced = [@__list_slice(stack, 0, len(stack) - 1), []]
  state[16] = replaced
  return state
end

// Reads `subject[name]` into a fresh register, returning [register, state].
verb emit_read_column(subject, column_name, state)
  let [symbol_reg, after_symbol] = load_constant(state, to_symbol(column_name))
  state = after_symbol
  let [column, after_column] = alloc_register(state)
  state = after_column
  let [_, after_index] = emit_instruction(state, :Index, 0, column, subject, symbol_reg)
  state = after_index
  return [column, state]
end

// Emits the tests for one pattern. Each test is followed by a branch to the
// next case, so later reads run only after earlier tests pass.
verb emit_match_pattern(rows, subject, pattern, state)
  let kind = ast_kind(rows, pattern)
  if kind == :Wildcard_Pattern
    return state
  end
  if kind == :Binding_Pattern
    let [found_name, binding_name] = ast_attr(rows, pattern, :name)
    let [destination, after_dest] = alloc_register(state)
    state = after_dest
    let [_, after_move] = emit_instruction(state, :Move, 0, destination, subject, 0)
    state = after_move
    if found_name
      state = declare_local(state, binding_name, destination, false)
    end
    return state
  end
  if kind == :Literal_Pattern
    let [found_value, value_node] = ast_attr(rows, pattern, :value)
    if !found_value
      return emit_error(state, "a literal pattern is missing its value")[1]
    end
    let [literal, after_literal] = emit_expr(rows, value_node, state)
    state = after_literal
    let [test, after_test] = alloc_register(state)
    state = after_test
    let [_, after_eq] = emit_instruction(state, :Binary, 5, test, subject, literal)
    state = after_eq
    return emit_match_fail_test(test, state)
  end
  if kind == :Call_Pattern
    return emit_match_call_pattern(rows, subject, pattern, state)
  end
  if kind == :List_Pattern
    return emit_match_list_pattern(rows, subject, pattern, state)
  end
  if kind == :Map_Pattern
    return emit_match_map_pattern(rows, subject, pattern, state)
  end
  return emit_error(state, "this pattern is not valid in a match case")[1]
end

// Matches `some(x)`, `ok(x)`, and `err(x)` against the option or result shape.
// `some` reads the :value column directly; `ok`/`err` first compare the :case
// symbol, then read :value.
verb emit_match_call_pattern(rows, subject, pattern, state)
  let [found_name, constructor] = ast_attr(rows, pattern, :name)
  if !found_name
    return emit_error(state, "a call pattern is missing its name")[1]
  end
  let value_option = -1
  if constructor == "some"
    let [option, after_option] = emit_pattern_lookup_symbol(subject, "value", state)
    state = after_option
    value_option = option
  elseif constructor == "ok" || constructor == "err"
    let expected_name = "ok"
    if constructor == "err"
      expected_name = "error"
    end
    let [case_option, after_case_option] = emit_pattern_lookup_symbol(subject, "case", state)
    state = after_case_option
    let [case_value, after_case_value] = emit_read_column(case_option, "value", state)
    state = after_case_value
    let [expected, after_expected] = load_constant(state, to_symbol(expected_name))
    state = after_expected
    let [test, after_test] = alloc_register(state)
    state = after_test
    let [_, after_eq] = emit_instruction(state, :Binary, 5, test, case_value, expected)
    state = after_eq
    state = emit_match_fail_test(test, state)
    let [option, after_option] = emit_pattern_lookup_symbol(subject, "value", state)
    state = after_option
    value_option = option
  else
    return emit_error(state, string_concat("unknown match constructor: ", constructor))[1]
  end

  let args = ast_children(rows, pattern, :arg)
  if len(args) > 1
    return emit_error(state, "match constructors take at most one binding")[1]
  end
  if len(args) == 1
    let arg_pattern = args[0]
    if ast_kind(rows, arg_pattern) != :Binding_Pattern
      return emit_error(state, "match pattern arguments must be names")[1]
    end
    let [found_binding_name, binding_name] = ast_attr(rows, arg_pattern, :name)
    let [column, after_column] = emit_read_column(value_option, "value", state)
    state = after_column
    if found_binding_name
      state = declare_local(state, binding_name, column, false)
    end
  end
  return state
end

// `__index_option(subject, key)` plus a presence test. Returns
// [option register, state]; the caller reads its :value only after the test.
verb emit_pattern_lookup(subject, key_reg, state)
  let [first, after_marshal] = marshal_arguments(state, [subject, key_reg])
  state = after_marshal
  let [builtin, after_builtin] = add_builtin(state, "__index_option")
  state = after_builtin
  let [option, after_option] = alloc_register(state)
  state = after_option
  let [_, after_call] = emit_instruction(state, :Builtin_Call, 0, option, builtin, first)
  state = after_call
  let [test, after_test] = alloc_register(state)
  state = after_test
  let [_, after_truthy] = emit_instruction(state, :Is_Truthy, 0, test, option, 0)
  state = after_truthy
  state = emit_match_fail_test(test, state)
  return [option, state]
end

verb emit_pattern_lookup_symbol(subject, column_name, state)
  let [key, after_key] = load_constant(state, to_symbol(column_name))
  state = after_key
  return emit_pattern_lookup(subject, key, state)
end

// Matches a list pattern. Without a rest element the length must match
// exactly; with @rest the fixed elements must be present and the middle is
// bound to the rest name.
verb emit_match_list_pattern(rows, subject, pattern, state)
  let [first, after_marshal] = marshal_arguments(state, [subject])
  state = after_marshal
  let [len_builtin, after_len_builtin] = add_builtin(state, "__len_option")
  state = after_len_builtin
  let [length_option, after_length_option] = alloc_register(state)
  state = after_length_option
  let [_, after_len_call] = emit_instruction(
    state, :Builtin_Call, 0, length_option, len_builtin, first,
  )
  state = after_len_call
  let [length_presence, after_presence] = alloc_register(state)
  state = after_presence
  let [_, after_truthy] = emit_instruction(
    state, :Is_Truthy, 0, length_presence, length_option, 0,
  )
  state = after_truthy
  state = emit_match_fail_test(length_presence, state)
  let [length_reg, after_read] = emit_read_column(length_option, "value", state)
  state = after_read

  let elements = ast_children(rows, pattern, :element)
  let rest_index = -1
  let index = 0
  for element in elements
    if ast_kind(rows, element) == :Rest_Pattern
      rest_index = index
      break
    end
    index = index + 1
  end
  let fixed_count = len(elements)
  if rest_index >= 0
    fixed_count = fixed_count - 1
  end
  let [length_value, after_length_value] = load_constant(state, fixed_count)
  state = after_length_value
  let [length_test, after_length_test] = alloc_register(state)
  state = after_length_test
  let op = 5
  if rest_index >= 0
    op = 9
  end
  let [_, after_test] = emit_instruction(state, :Binary, op, length_test, length_reg, length_value)
  state = after_test
  state = emit_match_fail_test(length_test, state)

  index = 0
  for element in elements
    let element_kind = ast_kind(rows, element)
    if element_kind == :Rest_Pattern
      let [found_rest_name, rest_name] = ast_attr(rows, element, :name)
      if found_rest_name
        state = emit_match_rest_binding(
          subject, length_reg, rest_name, index, len(elements) - index - 1, state,
        )
      end
      index = index + 1
      continue
    end
    let [item_index, after_item_index] = load_constant(state, index)
    state = after_item_index
    let [option, after_option] = emit_pattern_lookup(subject, item_index, state)
    state = after_option
    let [item, after_item] = emit_read_column(option, "value", state)
    state = after_item
    state = emit_match_pattern(rows, item, element, state)
    index = index + 1
  end
  return state
end

// Binds the middle of a list to `rest_name`, from `start` up to
// `length - trailing`, or the end when trailing is zero.
verb emit_match_rest_binding(subject, length_reg, rest_name, start, trailing, state)
  let [start_reg, after_start] = load_constant(state, start)
  state = after_start
  let end_reg = 0
  if trailing == 0
    let [end_const, after_end] = load_constant(state, -1)
    state = after_end
    end_reg = end_const
  else
    let [trailing_reg, after_trailing] = load_constant(state, trailing)
    state = after_trailing
    let [computed, after_computed] = alloc_register(state)
    state = after_computed
    let [_, after_sub] = emit_instruction(state, :Binary, 1, computed, length_reg, trailing_reg)
    state = after_sub
    end_reg = computed
  end
  let [first, after_marshal] = marshal_arguments(state, [subject, start_reg, end_reg])
  state = after_marshal
  let [builtin, after_builtin] = add_builtin(state, "__list_slice")
  state = after_builtin
  let [destination, after_destination] = alloc_register(state)
  state = after_destination
  let [_, after_call] = emit_instruction(
    state, :Builtin_Call, 3, destination, builtin, first,
  )
  state = after_call
  return declare_local(state, rest_name, destination, false)
end

// Matches a map pattern by reading each entry's value and matching it.
verb emit_match_map_pattern(rows, subject, pattern, state)
  let entries = ast_children(rows, pattern, :entry)
  for entry in entries
    let [found_key, key_node] = ast_attr(rows, entry, :key)
    if !found_key
      return emit_error(state, "a match map pattern entry is missing its key")[1]
    end
    let [found_key_name, key_name] = ast_attr(rows, key_node, :name)
    if !found_key_name
      return emit_error(state, "a match map pattern key is missing its name")[1]
    end
    let [option, after_option] = emit_pattern_lookup_symbol(subject, key_name, state)
    state = after_option
    let [value, after_value] = emit_read_column(option, "value", state)
    state = after_value
    let [found_pattern, entry_pattern] = ast_attr(rows, entry, :pattern)
    if !found_pattern
      return emit_error(state, "a match map pattern entry is missing its pattern")[1]
    end
    state = emit_match_pattern(rows, value, entry_pattern, state)
  end
  return state
end

// `#tag[1, 2]` and `#tag{a -> 1}` lower to the frob builtin: an identity
// delegate plus a payload. A named form makes a map from the cells; a
// positional form makes a list, or the single cell's value directly.
verb emit_frob(rows, node, state)
  let [found_head, head] = ast_attr(rows, node, :head)
  if !found_head || ast_kind(rows, head) != :Identity_Literal
    return emit_error(state, "a structural literal head must be an identity")
  end
  let [delegate, after_delegate] = emit_expr(rows, head, state)
  state = after_delegate

  let cells = ast_children(rows, node, :cell)
  let [named, _] = ast_attr(rows, node, :named)
  let payload = 0
  if named
    let [payload_reg, after_payload] = emit_frob_named_payload(rows, cells, state)
    state = after_payload
    payload = payload_reg
  elseif len(cells) == 1
    let [found_value, value_node] = ast_attr(rows, cells[0], :value)
    if !found_value
      return emit_error(state, "a structural cell is missing its value")
    end
    let [value_reg, after_value] = emit_expr(rows, value_node, state)
    state = after_value
    payload = value_reg
  else
    let [payload_reg, after_payload] = emit_frob_list_payload(rows, cells, state)
    state = after_payload
    payload = payload_reg
  end

  let [first, after_marshal] = marshal_arguments(state, [delegate, payload])
  state = after_marshal
  let [builtin, after_builtin] = add_builtin(state, "frob")
  state = after_builtin
  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_call] = emit_instruction(state, :Builtin_Call, 0, dst, builtin, first)
  state = after_call
  return [dst, state]
end

// Builds a map from named structural cells, returning [register, state].
verb emit_frob_named_payload(rows, cells, state)
  let registers = []
  for cell in cells
    let [found_name_node, cell_name_node] = ast_attr(rows, cell, :name)
    let [found_value, value_node] = ast_attr(rows, cell, :value)
    if !found_name_node || !found_value
      return [0, emit_error(state, "a named structural cell needs a name and value")[1]]
    end
    // The cell's :name is a Symbol_Literal node; the map key is its name.
    let [found_name, cell_name] = ast_attr(rows, cell_name_node, :name)
    if !found_name
      return [0, emit_error(state, "a named structural cell has a nameless key")[1]]
    end
    let [value_reg, after_value] = emit_expr(rows, value_node, state)
    state = after_value
    let [name_reg, after_name] = load_constant(state, to_symbol(cell_name))
    state = after_name
    registers = [@registers, name_reg]
    registers = [@registers, value_reg]
  end
  let [first, after_marshal] = marshal_arguments(state, registers)
  state = after_marshal
  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_map] = emit_instruction(state, :Build_Map, 0, dst, first, len(cells))
  state = after_map
  return [dst, state]
end

// Builds a list from positional structural cells, returning [register, state].
verb emit_frob_list_payload(rows, cells, state)
  // Collect each cell's value node and build the list through the shared
  // helper, so a splice cell (`#tag<[@xs, y]>`) concatenates rather than
  // being treated as one element.
  let values = []
  for cell in cells
    let [found_value, value_node] = ast_attr(rows, cell, :value)
    if !found_value
      return [0, emit_error(state, "a structural cell is missing its value")[1]]
    end
    values = [@values, value_node]
  end
  return emit_list_of_nodes(rows, values, state)
end

verb emit_mailbox_recv(rows, args, state)
  if len(args) < 1 || len(args) > 2
    return emit_error(state, "mailbox_recv expects a receiver list and optional timeout")
  end
  let [found_receivers, receivers_node] = ast_attr(rows, args[0], :expr)
  if !found_receivers
    return emit_error(state, "mailbox_recv is missing its receiver list")
  end
  let [receivers, after_receivers] = emit_expr(rows, receivers_node, state)
  state = after_receivers
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  if len(args) == 2
    let [found_timeout, timeout_node] = ast_attr(rows, args[1], :expr)
    if !found_timeout
      return emit_error(state, "mailbox_recv is missing its timeout")
    end
    let [timeout, after_timeout] = emit_expr(rows, timeout_node, state)
    state = after_timeout
    let [_, after_emit] = emit_instruction(state, :Mailbox_Recv, 1, dst, receivers, timeout)
    state = after_emit
  else
    let [_, after_emit] = emit_instruction(state, :Mailbox_Recv, 0, dst, receivers, 0)
    state = after_emit
  end
  return [dst, state]
end

// `spawn :verb(role: value, ...) [after seconds]` starts the selected verb in
// a new task. Arguments must be named by role, since dispatch selects the
// method by selector and role set. Lowers to a Spawn instruction carrying a
// dispatch spec index.
verb emit_spawn(rows, node, state)
  let [found_call, call_node] = ast_attr(rows, node, :call)
  if !found_call || ast_kind(rows, call_node) != :Call
    return emit_error(state, "spawn target must be a symbol call")
  end
  let [found_callee, callee_node] = ast_attr(rows, call_node, :callee)
  if !found_callee || ast_kind(rows, callee_node) != :Symbol_Literal
    return emit_error(state, "spawn target must use a symbol selector like :verb(...)")
  end
  let [found_selector, selector_name] = ast_attr(rows, callee_node, :name)
  if !found_selector
    return emit_error(state, "a spawn selector is missing its name")
  end

  let args = ast_children(rows, call_node, :arg)
  let roles = []
  for arg in args
    let [found_role, role_name] = ast_attr(rows, arg, :role)
    if !found_role
      return emit_error(state, "spawn arguments must use explicit role names")
    end
    let [found_expr, arg_expr] = ast_attr(rows, arg, :expr)
    if !found_expr
      return emit_error(state, "a spawn argument is missing its expression")
    end
    let [arg_reg, after_arg] = emit_expr(rows, arg_expr, state)
    state = after_arg
    roles = [@roles, {:role -> role_name, :register -> arg_reg}]
  end
  let spec_index = len(state[15])
  state[15] = [@state[15], {:selector -> selector_name, :roles -> roles}]

  let flags = 0
  let delay_reg = 0
  let [found_delay, _] = ast_attr(rows, node, :has_delay)
  if found_delay
    let [found_delay_node, delay_node] = ast_attr(rows, node, :delay)
    if found_delay_node
      let [delay, after_delay] = emit_expr(rows, delay_node, state)
      state = after_delay
      flags = 1
      delay_reg = delay
    end
  end
  let [dst, after_reg] = alloc_register(state)
  state = after_reg
  let [_, after_emit] = emit_instruction(state, :Spawn, flags, dst, spec_index, delay_reg)
  state = after_emit
  return [dst, state]
end

// `retract R(a, _, c)` retracts every row matching the bound cells. The
// pattern names the relation (resolved at scan time) and binds the non-
// wildcard arguments.
verb emit_retract_where(rows, args, relation_name, state)
  let column_names = []
  let cells = []
  let index = 0
  for arg in args
    let [found_expr, arg_expr] = ast_attr(rows, arg, :expr)
    if !found_expr
      return emit_error(state, "a retract argument is missing its expression")
    end
    column_names = [@column_names, generated_column(index)]
    if ast_kind(rows, arg_expr) == :Wildcard
      cells = [@cells, {:kind -> :Wildcard, :operand -> 0}]
    else
      let [arg_reg, after_arg] = emit_expr(rows, arg_expr, state)
      state = after_arg
      cells = [@cells, {:kind -> :Bind, :operand -> arg_reg}]
    end
    index = index + 1
  end
  let pattern_index = len(state[14])
  state[14] = [@state[14], {:name -> relation_name, :columns -> column_names, :cells -> cells}]
  let [dst, after_dst] = alloc_register(state)
  state = after_dst
  let [_, after_emit] = emit_instruction(state, :Retract_Where, 0, dst, pattern_index, 0)
  state = after_emit
  return [dst, state]
end

// Wraps `registers` as a one-row list of cell values, returning
// [register, state].
verb build_single_row(state, registers)
  let [first, after_marshal] = marshal_arguments(state, registers)
  state = after_marshal
  let [row, after_row] = alloc_register(state)
  state = after_row
  let [_, after_build] = emit_instruction(
    state, :Build_List, 0, row, first, len(registers),
  )
  state = after_build
  let [outer, after_outer] = alloc_register(state)
  state = after_outer
  let [_, after_outer_build] = emit_instruction(state, :Build_List, 0, outer, row, 1)
  state = after_outer_build
  return [outer, state]
end

// The generated heading name for column `position`, matching the Odin
// compiler so assembled shapes agree.
verb generated_column(position)
  return to_symbol(string_concat("column", string_from_chars([int_digit(position)])))
end

// The decimal text of a small non-negative integer. Column counts are tiny,
// so only a single digit is needed.
verb int_digit(value)
  return string_slice("0123456789", value % 10, value % 10 + 1)
end

verb emit_binding(rows, node, state)
  let [found_pattern, pattern] = ast_attr(rows, node, :pattern)
  if !found_pattern
    return emit_error(state, "a binding is missing its pattern")
  end
  let [binding_is_const, _] = ast_attr(rows, node, :is_const)
  let [found_rhs, rhs] = ast_attr(rows, node, :value)
  // A named `fn f(...) ...` is a self-recursive binding: the parser wraps it
  // as a Binding whose pattern names f and whose value is the Fn. The function
  // must capture its own value so its body can recurse.
  if found_rhs && ast_kind(rows, rhs) == :Fn && ast_kind(rows, pattern) == :Binding_Pattern
    let [found_binding_name, self_name] = ast_attr(rows, pattern, :name)
    if found_binding_name
      let [self_value, after_self] = emit_self_fn(rows, rhs, self_name, state)
      state = after_self
      let [dst, after_reg] = alloc_register(state)
      state = after_reg
      let [_, after_move] = emit_instruction(state, :Move, 0, dst, self_value, 0)
      state = after_move
      state = declare_local(state, self_name, dst, binding_is_const)
      return [dst, state]
    end
  end
  let rhs_reg = 0
  if found_rhs
    let [emitted, after_rhs] = emit_expr(rows, rhs, state)
    state = after_rhs
    rhs_reg = emitted
  else
    // `let x` with no value declares a binding for later assignment; it
    // starts as none.
    let [emitted, after_none] = load_constant(state, none_value())
    state = after_none
    rhs_reg = emitted
  end

  let pattern_kind = ast_kind(rows, pattern)
  if pattern_kind == :Binding_Pattern
    let [found_binding_name, binding_name] = ast_attr(rows, pattern, :name)
    if !found_binding_name
      return emit_error(state, "a binding pattern is missing its name")
    end
    // A mutable binding owns its register: the value may be a shared
    // preloaded constant, and a later assignment would overwrite that slot.
    let [dst, after_reg] = alloc_register(state)
    state = after_reg
    let [_, after_move] = emit_instruction(state, :Move, 0, dst, rhs_reg, 0)
    state = after_move
    state = declare_local(state, binding_name, dst, binding_is_const)
    return [dst, state]
  end
  if pattern_kind == :List_Pattern
    state = bind_list_scatter(rows, pattern, rhs_reg, binding_is_const, state)
    return [rhs_reg, state]
  end
  if pattern_kind == :Map_Pattern
    state = bind_map_pattern(rows, pattern, rhs_reg, state)
    return [rhs_reg, state]
  end
  if pattern_kind == :Wildcard_Pattern
    return [rhs_reg, state]
  end
  // `let some(x) = v` or `if let ok(x) = v`: bind x to the option/result's
  // :value column, and yield whether v is present (truthy) so `if let` can
  // test it.
  if pattern_kind == :Call_Pattern
    let args = ast_children(rows, pattern, :arg)
    if len(args) > 1
      return emit_error(state, "call patterns support one binding")
    end
    if len(args) == 1
      if ast_kind(rows, args[0]) != :Binding_Pattern
        return emit_error(state, "call pattern arguments must be names")
      end
      let [found_binding_name, binding_name] = ast_attr(rows, args[0], :name)
      let [column, after_column] = emit_read_column(rhs_reg, "value", state)
      state = after_column
      if found_binding_name
        state = declare_local(state, binding_name, column, binding_is_const)
      end
    end
    let [result, after_result] = alloc_register(state)
    state = after_result
    let [_, after_truthy] = emit_instruction(state, :Is_Truthy, 0, result, rhs_reg, 0)
    state = after_truthy
    return [result, state]
  end
  return emit_error(state, "a pattern needs a later slice")
end

// Scatters a list binding's elements by position. Unlike the for-header
// helper, a binding may not use a wildcard to skip a slot; `_` is a binding
// name here, matching the Odin emitter.
verb bind_list_scatter(rows, pattern, value_reg, constant_flag, state)
  let elements = ast_children(rows, pattern, :element)
  let position = 0
  for element in elements
    let element_kind = ast_kind(rows, element)
    if element_kind == :Binding_Pattern
      let [found_name, binding_name] = ast_attr(rows, element, :name)
      let [index_reg, after_index] = load_constant(state, position)
      state = after_index
      let [column, after_column] = alloc_register(state)
      state = after_column
      let [_, after_index_op] = emit_instruction(
        state, :Index, 0, column, value_reg, index_reg,
      )
      state = after_index_op
      if found_name
        state = declare_local(state, binding_name, column, false)
      end
    elseif element_kind == :Wildcard_Pattern
      // `_` discards this position but still consumes a slot, so a later
      // element keeps its ordinal.
    elseif element_kind == :Optional_Pattern
      state = bind_optional_scatter(rows, element, value_reg, position, false, state)
    elseif element_kind == :Rest_Pattern
      let [found_name, rest_name] = ast_attr(rows, element, :name)
      if found_name
        state = bind_rest_scatter(rows, element, value_reg, position, false, state, rest_name)
      end
      // A rest consumes the remaining positions, so later elements do not
      // exist; the parser enforces it is last.
    else
      return emit_error(state, "a list binding needs names")[1]
    end
    position = position + 1
  end
  return state
end

// Binds `?name = default` from position `position`, falling back to the
// default (or the empty relation) when the list is too short.
verb bind_optional_scatter(rows, element, value_reg, position, constant_flag, state)
  let [found_name, binding_name] = ast_attr(rows, element, :name)
  let [destination, after_dest] = alloc_register(state)
  state = after_dest
  let [length_reg, after_len] = alloc_register(state)
  state = after_len
  let [_, after_len_op] = emit_instruction(state, :Len, 0, length_reg, value_reg, 0)
  state = after_len_op
  let [index_reg, after_index] = load_constant(state, position)
  state = after_index
  let [present, after_present] = alloc_register(state)
  state = after_present
  let [_, after_cmp] = emit_instruction(state, :Binary, 9, present, length_reg, index_reg)
  state = after_cmp
  let [present_jump, after_present_jump] = emit_jump(state, :Branch, 0, present)
  state = after_present_jump
  let [missing_jump, after_missing_jump] = emit_jump(state, :Jump, 0, 0)
  state = after_missing_jump
  state = patch_jump(state, present_jump, current_offset(state))

  let [item, after_item] = alloc_register(state)
  state = after_item
  let [_, after_index_op] = emit_instruction(state, :Index, 0, item, value_reg, index_reg)
  state = after_index_op
  let [_, after_move] = emit_instruction(state, :Move, 0, destination, item, 0)
  state = after_move
  let [end_jump, after_end_jump] = emit_jump(state, :Jump, 0, 0)
  state = after_end_jump
  state = patch_jump(state, missing_jump, current_offset(state))

  let [found_default, default_node] = ast_attr(rows, element, :default)
  let default_reg = 0
  if found_default
    let [emitted, after_default] = emit_expr(rows, default_node, state)
    state = after_default
    default_reg = emitted
  else
    let [emitted, after_empty] = load_constant(state, empty_relation_value())
    state = after_empty
    default_reg = emitted
  end
  let [_, after_default_move] = emit_instruction(state, :Move, 0, destination, default_reg, 0)
  state = after_default_move
  state = patch_jump(state, end_jump, current_offset(state))
  if found_name
    state = declare_local(state, binding_name, destination, constant_flag)
  end
  return state
end

// Binds `@rest` from position `position` to the end of the list.
verb bind_rest_scatter(rows, element, value_reg, position, constant_flag, state, rest_name)
  let [start_reg, after_start] = load_constant(state, position)
  state = after_start
  let [end_reg, after_end] = load_constant(state, -1)
  state = after_end
  let [first, after_marshal] = marshal_arguments(state, [value_reg, start_reg, end_reg])
  state = after_marshal
  let [builtin, after_builtin] = add_builtin(state, "__list_slice")
  state = after_builtin
  let [destination, after_dest] = alloc_register(state)
  state = after_dest
  let [_, after_call] = emit_instruction(state, :Builtin_Call, 3, destination, builtin, first)
  state = after_call
  return declare_local(state, rest_name, destination, false)
end

verb emit_assignment(rows, node, state)
  let [found_target, target] = ast_attr(rows, node, :target)
  let [found_rhs, rhs] = ast_attr(rows, node, :value)
  if !found_target || !found_rhs
    return emit_error(state, "an assignment is missing its target or value")
  end
  let target_kind = ast_kind(rows, target)

  // `receiver.name = value` lowers to the __set_field builtin with the
  // receiver, the field name as a symbol, and the value.
  if target_kind == :Field
    let [found_receiver, receiver_node] = ast_attr(rows, target, :receiver)
    let [found_field_name, field_name] = ast_attr(rows, target, :name)
    if !found_receiver || !found_field_name
      return emit_error(state, "a field assignment is missing its receiver or name")
    end
    let [receiver, after_receiver] = emit_expr(rows, receiver_node, state)
    state = after_receiver
    let [name_reg, after_name] = load_constant(state, to_symbol(field_name))
    state = after_name
    let [value_reg, after_value] = emit_expr(rows, rhs, state)
    state = after_value
    let [first, after_marshal] = marshal_arguments(state, [receiver, name_reg, value_reg])
    state = after_marshal
    let [builtin, after_builtin] = add_builtin(state, "__set_field")
    state = after_builtin
    let [dst, after_dst] = alloc_register(state)
    state = after_dst
    let [_, after_call] = emit_instruction(state, :Builtin_Call, 0, dst, builtin, first)
    state = after_call
    return [value_reg, state]
  end

  // `collection[key] = value` replaces the element and rebinds the name, since
  // Mica values are immutable.
  if target_kind == :Index
    let [found_collection, collection_node] = ast_attr(rows, target, :collection)
    let [found_key, key_node] = ast_attr(rows, target, :key)
    if !found_collection || !found_key || ast_kind(rows, collection_node) != :Name
      return emit_error(state, "indexed assignment requires a named collection")
    end
    let [named, collection_name] = single_name(rows, collection_node)
    if !named
      return emit_error(state, "a qualified collection needs a later slice")
    end
    let [found, collection, collection_is_const] = resolve_local(state, collection_name)
    if !found
      return emit_error(state, "assignment to an unknown collection")
    end
    if collection_is_const
      return emit_error(state, "assignment to a constant binding")
    end
    let [key_reg, after_key] = emit_expr(rows, key_node, state)
    state = after_key
    let [value_reg, after_value] = emit_expr(rows, rhs, state)
    state = after_value
    let [first, after_marshal] = marshal_arguments(state, [collection, key_reg, value_reg])
    state = after_marshal
    let [builtin, after_builtin] = add_builtin(state, "__set_index")
    state = after_builtin
    let [destination, after_destination] = alloc_register(state)
    state = after_destination
    let [_, after_call] = emit_instruction(state, :Builtin_Call, 3, destination, builtin, first)
    state = after_call
    let [_, after_move] = emit_instruction(state, :Move, 0, collection, destination, 0)
    state = after_move
    return [destination, state]
  end

  if target_kind != :Name
    return emit_error(state, "an assignment target needs a later slice")
  end
  let [named, binding_name] = single_name(rows, target)
  if !named
    return emit_error(state, "a qualified target needs a later slice")
  end
  let [found, reg, target_is_const] = resolve_local(state, binding_name)
  if !found
    return emit_error(state, "an unknown target needs a later slice")
  end
  if target_is_const
    return emit_error(state, "assignment to a constant binding")
  end
  let [rhs_reg, after_rhs] = emit_expr(rows, rhs, state)
  state = after_rhs
  let [_, after_move] = emit_instruction(state, :Move, 0, reg, rhs_reg, 0)
  state = after_move
  return [reg, state]
end

verb emit_return(rows, node, state)
  let [found, result_node] = ast_attr(rows, node, :value)
  if !found
    return emit_error(state, "a bare return needs a later slice")
  end
  let [result_reg, after_result] = emit_expr(rows, result_node, state)
  state = after_result
  let [_, after_emit] = emit_instruction(state, :Return, 0, result_reg, 0, 0)
  state = after_emit
  return [result_reg, state]
end
